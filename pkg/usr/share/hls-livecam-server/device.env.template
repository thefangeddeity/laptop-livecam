# Defaults for every node. setup ADDS any key missing from device.env and
# never overwrites one that is there. Hardware keys are detected, not set here.
# Reference: hosts/tanzania/etc/hls-livecam/device.env (the working node).
CV_DETECT_CLASSES=human,cat
CV_DETECT_CONF=0.35
CV_SCENE_ENABLED=1
CV_SCENE_SOURCE=own-camera
CV_SCENE_REFERENCE=/var/lib/hls-livecam/scene_model.json
AUDIO_ENABLED=1
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_MIXER_LEVELS=Capture=50,Internal Mic Boost=0
AUDIO_SINGLE_SESSION=0
AUDIO_LOOPBACK_SINK=hw:Loopback,0,0
AUDIO_LOOPBACK_SRC=hw:Loopback,1,0
CV_FOVEAL_ENABLED=1
TALK_GAIN_DB=0
ECHO_DUCK=0
TALK_OUTPUT=hw:CARD=PCH,DEV=0
AUDIO_LOUDNORM=off
NOTIFY_ENABLED=1
NOTIFY_CLASSES=cat
NOTIFY_APPRISE_URLS_FILE=/etc/hls-livecam/notify.urls
NIGHT_V4L2_CTRLS=auto_exposure=1,exposure_time_absolute=2000,gain=96
DAY_V4L2_CTRLS=gain=0,auto_exposure=3
NIGHT_V4L2_INPUT_FMT=yuyv422
NIGHT_VIDEO_SIZE=640x360
NIGHT_STACK=8
