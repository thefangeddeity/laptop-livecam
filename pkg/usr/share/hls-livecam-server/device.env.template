# Defaults for every node. setup ADDS any key missing from device.env and
# never overwrites one that is there. Hardware keys (VIDEO_DEVICE,
# AUDIO_DEVICE, AUDIO_MIXER_CARD, TALK_OUTPUT) are detected by setup, not
# set here. Values are tanzania's, the reference node, measured 2026-11-10
# (hosts/tanzania/etc/hls-livecam/device.env).
CV_DETECT_CLASSES=human,cat
# tanzania runs 0.50; 0.35 let through more false "human" on cat-sized blobs.
CV_DETECT_CONF=0.50
# Off: needs a registration artifact a fresh node does not have. On without
# one, the scene stage logs FileNotFoundError on every pass.
CV_SCENE_ENABLED=0
CV_FOVEAL_ENABLED=1
AUDIO_ENABLED=1
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_MIXER_LEVELS=Capture=50,Internal Mic Boost=0
AUDIO_SINGLE_SESSION=0
AUDIO_LOOPBACK_SINK=hw:Loopback,0,0
AUDIO_LOOPBACK_SRC=hw:Loopback,1,0
AUDIO_LOUDNORM=off
TALK_GAIN_DB=0
ECHO_DUCK=0
NOTIFY_ENABLED=1
NOTIFY_CLASSES=cat
NOTIFY_CLASSES_FILE=/var/lib/hls-livecam/notify_classes
NOTIFY_APPRISE_URLS_FILE=/etc/hls-livecam/notify.urls
NOTIFY_SHOTS=1
NOTIFY_MIN_FG=0.25
# The evidence recorder (not the mediamtx recording, which records the
# PUBLISHED stream and is black in Hide) and the alert clips cut from it.
NOTIFY_REC_DIR=/var/lib/hls-livecam/rec/evidence
NOTIFY_CLIP_PRE=5
NOTIFY_CLIP_POST=20
RECORD_BITRATE=800k
RECORD_SEGMENT_S=60
RECORD_RETENTION_H=6
NIGHT_V4L2_CTRLS=auto_exposure=1,exposure_time_absolute=2000,gain=96
DAY_V4L2_CTRLS=gain=0,auto_exposure=3
NIGHT_V4L2_INPUT_FMT=yuyv422
NIGHT_VIDEO_SIZE=640x360
NIGHT_STACK=8
