[Unit]
Description=hls-livecam -- the livecam's services, together
# One switch for the whole livecam (camdash --start / --yield / --status).
# Each member is PartOf this target (a drop-in written by hls-livecam-suite):
# stopping the target stops them all. The members are enabled through this
# target, not one by one, so whether the livecam comes back after a reboot is
# one question: is this target enabled?
Wants=mediamtx.service ffmpeg-cam.service broadcast-api.service
# The camera suite: the livecam and cambrian-perception share the camera and
# never run together -- starting either stops the other. cambrian.target
# declares the same; either declaration alone is enough, and naming a unit
# that isn't installed is harmless.
Conflicts=cambrian.target

[Install]
WantedBy=multi-user.target
