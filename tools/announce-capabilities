#!/usr/bin/env python3
"""Announce a summary of this node's capabilities to the LAN over mDNS.

Avahi reads /etc/avahi/services and reloads on change, so writing the file IS
the announcement -- there is no daemon to poke. TXT records are small, so they
carry a summary plus a path to the full document rather than a copy of it.

The one rule that matters here: `unknown` is published as 'u', never as '0'.
A peer must be able to tell "this node cannot" from "nobody has checked".
Flattening those together in the announcement would undo the entire point of
measuring provenance in the first place.
"""
import json
import os
import sys

SERVICE_DIR = '/etc/avahi/services'
SERVICE_FILE = os.path.join(SERVICE_DIR, 'livecam-node.service')

HEADER = """<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Generated by publish-capabilities; rewritten on every probe, do not edit.
     These records are a SUMMARY. doc= points at the full document, served
     from this node's own web root. A value of 'u' means unknown, NOT false. -->
<service-group>
  <name replace-wildcards="yes">livecam on %h</name>
  <service>
    <type>_livecam-node._tcp</type>
    <port>8080</port>
"""
FOOTER = """  </service>
</service-group>
"""


def tri(doc, section, key):
    """'1' / '0' / 'u' -- never collapse unknown into false."""
    c = doc.get(section, {}).get(key, {})
    if c.get('source') == 'unknown' or c.get('value') is None:
        return 'u'
    return '1' if c['value'] else '0'


def build(doc):
    rows = [
        ('node', doc['identity']['node']['value']),
        ('host', tri(doc, 'radio', 'could_host_link')),
        ('proven', tri(doc, 'radio', 'link_hosting_proven')),
        ('tlsoff', tri(doc, 'secure_context', 'survives_offline')),
        ('cv', tri(doc, 'cv', 'can_render')),
        ('mic', tri(doc, 'mic', 'has_signal')),
        ('msgr', tri(doc, 'services', 'messenger')),
        ('free', str(doc.get('storage', {}).get('free_mb', {}).get('value', 'u'))),
        ('doc', '/capabilities.json'),
        ('schema', str(doc.get('schema', 1))),
    ]
    body = ''.join('    <txt-record>%s=%s</txt-record>\n' % r for r in rows)
    return HEADER + body + FOOTER


def main():
    if not os.path.isdir(SERVICE_DIR):
        print('  no avahi service dir; not announcing')
        return 0
    try:
        doc = json.load(open(sys.argv[1]))
    except Exception as exc:
        print('  cannot read %s: %s' % (sys.argv[1], exc), file=sys.stderr)
        return 1
    xml = build(doc)
    # Written only when the content differs, so an unchanged run does not
    # churn the daemon or restate an announcement nobody needed.
    try:
        if open(SERVICE_FILE).read() == xml:
            print('  announcement unchanged')
            return 0
    except Exception:
        pass
    tmp = SERVICE_FILE + '.tmp'
    with open(tmp, 'w') as fh:
        fh.write(xml)
    os.chmod(tmp, 0o644)
    os.replace(tmp, SERVICE_FILE)
    print('  announced -> %s' % SERVICE_FILE)
    return 0


if __name__ == '__main__':
    sys.exit(main())
