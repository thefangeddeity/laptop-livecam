@app.route('/api/notify-classes', methods=['GET'])
def notify_classes_get():
    return ','.join(_read_notify_classes()), 200


@app.route('/api/notify-classes', methods=['POST'])
def notify_classes_post():
    want = [c.strip().lower()
            for c in request.get_data(as_text=True).replace('\n', ',').split(',')
            if c.strip()]
    picked = [c for c in want if c in _ALERT_CLASSES]
    try:
        os.makedirs(os.path.dirname(NOTIFY_CLASSES_FILE), exist_ok=True)
        with open(NOTIFY_CLASSES_FILE, 'w') as f:
            # EXPANDED, not as picked. cv_notify matches these names against a
            # track's class and has no expansion table of its own, so storing
            # the raw selection meant "All animate beings" stored the single
            # token 'living' -- which matches no track, and alerted on nothing.
            f.write(','.join(_expand_classes(picked)))
    except Exception:
        abort(500)
    # Return the same answer GET would give, expansion included. Returning the
    # raw selection instead made the panel paint one thing on click and
    # another on its next poll.
    return ','.join(_read_notify_classes()), 200


@app.route('/api/detect-always', methods=['GET'])
def detect_always_get():
    return ('true' if _detect_always else 'false'), 200


@app.route('/api/detect-always', methods=['POST'])
def detect_always_post():
    global _detect_always, _mode_generation
    want = request.get_data(as_text=True).strip().lower()
    # REJECT anything that is not an explicit true/false. This used to fall
    # back to `not _detect_always` -- so a garbled, truncated or retried body
    # FLIPPED the setting instead of setting it, and a client that believed it
    # was turning detection off could turn it on. A toggle is the wrong
    # default for a request whose intent could not be read: the safe answer to
    # "I could not understand you" is to change nothing and say so.
    if want not in ('true', 'false'):
        abort(400)
    with _mode_lock:
        _detect_always = (want == 'true')
        # Which publisher Show spawns depends on this, so the writer loop has
        # to rebuild -- same reason Blur bumps it and Foveal does not.
        _mode_generation += 1
    try:

        _write_detect_always(_detect_always)

    except Exception:

        abort(500)
    # Hide does not dim the picture here, it CLOSES the camera and publishes
    # generated black (indicator light out, mic shut). Nothing can be detected
    # through that, so switching detection on while hidden would be a control
    # that silently does nothing. Open the camera instead.
    # Deliberately does NOT force the camera open. Hide is a privacy control,
    # and a background feature that silently overrides one is not a feature,
    # it is a bug with a nice name -- the viewer is told the consequence
    # instead (see /api/hide-stops-detection) and decides for itself.
    return ('true' if _detect_always else 'false'), 200


@app.route('/api/cv-foveal-mode', methods=['GET'])
def cv_foveal_get():
    return ('true' if _cv_foveal_mode else 'false'), 200


@app.route('/api/cv-foveal-mode', methods=['POST'])
def cv_foveal_post():
    global _cv_foveal_mode
    with _mode_lock:
        want = request.get_data(as_text=True).strip().lower()
        _cv_foveal_mode = (want == 'true') if want in ('true', 'false') else not _cv_foveal_mode
    # No _mode_generation bump: unlike Blur, Foveal never changes which
    # devices ffmpeg opens or which mode the publisher spawns for -- it only
    # changes what CVProcessor.process() does with a frame it already has,
    # so nothing needs tearing down.
    return ('true' if _cv_foveal_mode else 'false'), 200


@app.route('/api/feed-mode', methods=['GET'])
def feed_mode_get():
    with _mode_lock:
        return _mode, 200


@app.route('/api/feed-mode', methods=['POST'])
def feed_mode_post():
    global _mode
    new_mode = request.get_data(as_text=True).strip()
    # `cloak` is accepted as a deprecated alias for `cv`. Blur is gone -- the
    # slot is retargeted at computer vision -- but camdash and the Qt
    # dashboard still POST the old word, and they are a separate thread of
    # work. Accepting both keeps them functional across that gap.
    #
    # Note the GET side returns `cv`, so an un-updated client will not see its
    # own button highlight. That is harmless today because the mode renders
    # nothing on macOS at all; remove this alias once camdash and the Qt
    # dashboard are ported.
    if new_mode == 'cloak':
        new_mode = 'cv'
    if new_mode not in ('show', 'cv', 'hide', 'night'):
        abort(400)
    global _mode_generation
    with _mode_lock:
        changed = (new_mode != _mode)
        _mode = new_mode
        if changed:
            _mode_generation += 1
    if changed:
        _write_mode(new_mode)
    return new_mode, 200


