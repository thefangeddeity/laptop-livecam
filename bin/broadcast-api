           if _IN_BUNDLE else os.path.join(STATE_DIR, "logs"))
FFMPEG_LOG     = os.path.join(LOG_DIR, "capture-ffmpeg.log")
FFMPEG_LOG_MAX = 2 * 1024 * 1024
try:
    os.makedirs(LOG_DIR, exist_ok=True)
except Exception:
    pass

sys.path.insert(0, BIN_DIR)
import block_art as _ba

BROADCAST_FILE = os.path.join(STATE_DIR, "broadcast.txt")
BUZZ_FILE      = os.path.join(STATE_DIR, "buzz.txt")
