def _png_to_raw(png_bytes):
    return Image.open(io.BytesIO(png_bytes)).convert('RGB').tobytes()


def _apply_svhs_warp(arr):
    import math
    rng = np.random.default_rng(42)
    order = rng.permutation(arr.shape[0])
    shuffled = arr[order]
    out = np.empty_like(shuffled)
    for y in range(shuffled.shape[0]):
        shift = int(180 * math.sin(2 * math.pi * y / 120))
        out[y] = np.roll(shuffled[y], shift, axis=0)
    return out


# -- Talkback player ---------------------------------------------------
#
# Ported from amira. A viewer pressing TALK or 2-WAY publishes its microphone
# to mediamtx's 'talkback' path over WHIP; that half has always worked. What
# was missing is that nothing on this machine ever READ that path, so the
# audio arrived and stopped there. Publishing is not playing.
#
# This reads talkback and plays it out through AudioToolbox, which is the only
# audio OUTPUT device ffmpeg exposes on macOS -- avfoundation is input-only
# here, which is why the obvious symmetric choice is not available.
#
# Supervised rather than spawned on demand, and the race is worth naming:
# mediamtx accepts a WHIP publisher BEFORE its first packet arrives, so a
# player started the instant a viewer says "talking" can find the path empty,
# exit, and leave the room silent for a microphone that is in fact about to
# work. A patient retry loop has no such race -- it is always already waiting.

# The room, again, as Opus on its own path -- the inbound half of 2-WAY.
#
# WebRTC cannot carry AAC. mediamtx does not transcode, and says so plainly
# when a WHEP reader attaches to 'cam': "skipping track with codec MPEG-4
# Audio", handing over video only. That is fatal for two-way audio twice
# over -- the room cannot be heard during a call, and the browser's echo
# canceller has no reference signal, so the far end hears itself back.
#
# So the same microphone leaves here a second time in a codec WebRTC accepts.
# One extra encode off a capture that is already running; the AAC track on
# 'cam' is untouched, and HLS viewers see no difference at all.
ROOM_AUDIO_URL = f"rtsp://127.0.0.1:{RTSP_PORT}/roomaudio"
# Same microphone, AAC, for the HLS listen path (see the mic
# publisher). Separate mediamtx path because one path carries one
# set of tracks.
ROOM_SOUND_URL = f"rtsp://127.0.0.1:{RTSP_PORT}/roomsound"


def _roomaudio_filter(for_rtc=False):
    """The microphone filter chain, built in ONE place.

    It used to derive from audio_filter_args(), which is the capture chain the
    camera publisher uses. That coupling was a trap: audio_filter_args() always
    returns an -af (it appends the rate/layout guarantee even with no gain), so
    a second branch here meant to add microphone-only elements never ran, and
    the elements were silently absent from the command.
    """
    chain = list(_mic_chain(for_rtc=for_rtc))

    # Optional fixed capture gain, kept last so it acts on the cleaned signal.
    # A room mic is quiet by nature. alimiter is a ceiling, not a compressor:
    # a limiter that is CONSTANTLY engaged pumps, and pumping is a rhythm --
    # the exact class of fault that cost a day here.
    gain = str(_cfg.get('AUDIO_GAIN_DB', '')).strip()
    if gain:
        try:
            float(gain)
        except ValueError:
            gain = ''
    if gain:
        chain.append(f'volume={gain}dB')
        chain.append('alimiter=limit=0.97')

    return ['-af', ','.join(chain)]


def _mic_chain(for_rtc=False):
    """The microphone filter chain, in order.

    TWO JOBS, TWO CHAINS, off ONE capture.

    The MONITOR wants fidelity. This is a suburban room: voices outside, car
    horns, birds, doors slamming, pots and pans, a dog. Those events ARE the
    signal -- the reason to listen at all -- so nothing here may decide which
    sounds matter.

    TWO-WAY wants intelligibility: one person's voice pulled out of exactly
    that racket, at the far end of a call. Opposite requirement, so it gets
    the speech denoiser and the monitor does not.

    Deliberately short either way. Every element is one more thing that can
    put a rhythm into the sound, which is exactly how the last fault hid.
    """
    chain = ['aformat=sample_rates=48000:channel_layouts=mono']

    # Rumble cut. A room mic picks up desk knocks, HVAC and handling noise
    # below the voice band; nothing wanted lives under ~80 Hz, and removing it
    # before any denoiser means the denoiser is not spending its budget on
    # energy we were going to discard anyway.
    hp = str(_cfg.get('AUDIO_HIGHPASS_HZ', '')).strip()
    if hp:
        # CASCADED STAGES (ported from Tanzania <- originally 7elwe, 2026-09-10):
        # ffmpeg's highpass is a single 2nd-order Butterworth section, 12 dB/oct --
        # too gentle a shoulder for broadband road/traffic rumble. Repeating the
        # SAME filter cascades the slope (each stage +12 dB/oct) while leaving
        # everything above the corner untouched, so the corner can stay
        # speech-safe and the shoulder gets as steep as the room needs.
        try:
            hp_stages = max(1, min(4, int(_cfg.get('AUDIO_HIGHPASS_STAGES', '1'))))
        except ValueError:
            hp_stages = 1
        chain.extend([f'highpass=f={hp}'] * hp_stages)

    # Ceiling cut (requirement: "LP slope should also be there" -- Tanzania parity).
    # Ariana never had a low-pass at all until now: HF hiss was this room's
    # loudest octave before any treatment, so the top shoulder had exactly
    # the same single-section weakness the bottom one did before cascading.
    # Same 14000 Hz default as Tanzania (speech tops out ~8 kHz, all
    # intelligibility below ~4 kHz -- 14k removes ultra-high hiss/fizz with
    # no effect on voice or room "air"). AUDIO_LOWPASS_STAGES cascades it the
    # same way as the highpass above.
    lp = str(_cfg.get('AUDIO_LOWPASS_HZ', '14000')).strip()
    if lp:
        try:
            lp_stages = max(1, min(4, int(_cfg.get('AUDIO_LOWPASS_STAGES', '1'))))
        except ValueError:
            lp_stages = 1
        chain.extend([f'lowpass=f={lp}'] * lp_stages)

    # NEURAL DENOISE (RNNoise, via ffmpeg's arnndn).
    #
    # A recurrent network trained on speech-vs-noise; it suppresses broadband
    # hiss, fan and crackle while leaving voice intact, which fixed-band
    # filtering cannot do. Model files live in models/*.rnnn.
    #
    # APPLIED TO THE TWO-WAY LEG ONLY. It is a speech model: it keeps voice
    # and suppresses everything else, which is right for a call and wrong for
    # a monitor, where the birds and the slamming door are the point. Set
    # AUDIO_DENOISE to a model name (sh, bd, cb); it never touches the
    # monitor chain.
    # STATIONARY NOISE REMOVAL, for the monitor.
    #
    # The distinction that matters here is not frequency, it is PERSISTENCE.
    # Processing hiss, codec grit, mains hum and the fan floor are stationary:
    # the same spectrum second after second. A dog, a horn, a slamming door is
    # transient. afftdn keeps a running estimate of what is ALWAYS there and
    # subtracts only that, so a bark never enters the estimate and comes
    # through whole.
    #
    # Measured on this room: the strongest steady energy is a broad 59-123 Hz
    # band at roughly equal level -- a rumble floor, not a 60 Hz mains spike --
    # which a highpass can only clip the bottom of without also thinning door
    # thumps.
    #
    # nr is in dB of reduction. Gentle on purpose: spectral subtraction that
    # reaches too far leaves musical-noise artifacts, and this system has
    # already lost a day to a filter that put a rhythm in the sound.
    nr = str(_cfg.get('AUDIO_NR_DB', '')).strip() if not for_rtc else ''
    if nr:
        chain.append(f'afftdn=nr={nr}:nf=-40:tn=1')

    dn = str(_cfg.get('AUDIO_DENOISE', '')).strip() if for_rtc else ''
    if dn:
        model = os.path.join(ROOT, 'models', f'{dn}.rnnn')
        if os.path.exists(model):
            chain.append(f'arnndn=m={model}')
        else:
            print(f'broadcast-api: AUDIO_DENOISE={dn} but {model} is missing; '
                  f'continuing without denoise', file=sys.stderr, flush=True)
    return chain


def _roomaudio_output(audio_map, audio_filter):
    """Second output for a capture ffmpeg: the mic again, as Opus.

    No -ar/-ac here, deliberately. ffmpeg 8.1.2 refuses to open an
    avfoundation microphone at all when either appears ANYWHERE in the
    command -- the regression this tree already works around with an aformat
    filter -- and a rate/channel argument added for the benefit of an output
    would take the capture's input down with it. libopus takes the 48 kHz
    stereo the aformat filter already guarantees, so neither is needed.

    aresample=async=1000, roomaudio-only: mediamtx's own WebRTC/Opus reader
    fanout (bluenviron/mediamtx#3878) needs precise 20ms frame timing, which
    an avfoundation capture sharing a live x264 encode on the same process
    does not reliably deliver. mediamtx recomputes Opus timestamps from
    scratch since 1.15.2 and can absorb small jitter, but the untreated
    source is still the documented trigger for the choppy/bursty read-side
    symptom that issue describes -- upgrading the reader (mediamtx) without
    steadying the writer (this encode) was treating the wrong end. Scoped to
    roomaudio alone: the AAC track on 'cam' feeds HLS, which re-derives its
    own segment timing and was never the one showing the symptom.
    """
    filt = list(audio_filter)
    if '-af' in filt:
        i = filt.index('-af') + 1
        chain = filt[i]
        # Strip the A/V resample lock. See the module note above: this output
        # carries no video, so holding it against the video clock can only
        # add corrections, never remove drift that matters.
        chain = ','.join(p for p in chain.split(',')
                         if not p.startswith('aresample=async'))
        # Re-added after measuring: without it this output delivered only
        # ~12.7s of audio per 65s of wall clock -- a fifth of real time. The
        # content was clean (0%% below -60dB, no periodicity in the envelope),
        # so the fault was never the samples, it was the PACING: the receiver
        # starved between fragments, which is what the "polling" artifact
        # actually is. async here is not video sync -- there is no video in
        # this output -- it is what keeps the muxer emitting in real time.
        # async=1 + min_hard_comp, not async=1000. async is a CEILING on
        # samples/sec the filter may add or drop: 1000 let it continuously
        # stretch and squeeze to chase jittery capture timestamps, and that
        # constant micro-correction is audible. Measured here at async=1000:
        # envelope autocorrelation 0.41 at 0.15s and 0.40 at 0.35s -- a real
        # 3-6Hz chop, matching the reported 'pulses about four times a
        # second'. async=1 corrects drift gently (<0.5s), while
        # min_hard_comp=0.100 pads a genuine gap ONCE instead of smearing
        # the correction across everything. first_pts=0 stops the stream
        # starting at an arbitrary offset. This is the standard live-capture
        # form; dropping aresample entirely is not an option -- without it
        # this output delivered a fifth of real time.
        chain = chain + ',aresample=async=1:min_hard_comp=0.100:first_pts=0'
        # MONO, and it has to happen in the filter chain: -ac would kill the
        # avfoundation input outright (see above). One built-in mic is a mono
        # source in all but name, so a stereo Opus frame spent half its bits
        # describing a duplicate channel -- at 64k that left ~32k of real
        # signal per side. Folding to mono hands the whole budget to the one
        # channel that carries anything.
        chain = chain.replace('channel_layouts=stereo',
                              'channel_layouts=mono')
        filt[i] = chain
    else:
        filt = ['-af', 'aformat=channel_layouts=mono']
    return [
        # 96k mono, not 64k stereo -- roughly triple the bits per real
        # channel. This also has to cover the FEC redundancy, which comes out
        # of the same budget, so -packet_loss 10 was quietly taxing a figure
        # that was already thin.
        '-map', audio_map, '-c:a', 'libopus', '-b:a', '96k',
        # 'audio', not 'voip'. voip is Opus's speech-only mode: it optimises
        # for intelligibility of one talker and spends nothing on the rest of
        # the band, which is why a room came through thin and synthetic. This
        # is a room monitor -- ambience, distance, more than one voice -- so
        # the full-band mode is the honest choice. The Talk/2-Way legs are
        # separate encodes and keep their own settings.
        '-application', 'audio',
        # In-band FEC: libopus tucks a reduced-bitrate copy of the PREVIOUS
        # frame inside the NEXT packet. A decoder that sees a gap in RTP
        # sequence numbers reconstructs from that redundancy instead of
        # concealment silence -- entirely transparent to the receiver, no
        # SDP negotiation required (unlike RED, which needs its own payload
        # type). packet_loss is the rate the encoder BUDGETS redundancy for,
        # not a measurement -- 10% is the same default every consumer
        # video-call stack (WebRTC's own default) ships with.
        '-packet_loss', '10', '-fec', '1',
        *filt,
        '-rtsp_transport', 'tcp', '-f', 'rtsp', ROOM_AUDIO_URL,
    ]




# The talkback player lives in mediamtx's runOnReady on the talkback path
# now (see gen_mediamtx_yml in bin/livecam): started when a publisher
# appears, killed when they leave. It used to be a 4-second retry loop
# here that held an AudioToolbox device open forever.


def _start_publisher():
    """Publisher ffmpeg: reads processed RGB frames from stdin, pushes RTSP.

    cloak/hide rendering (block_art, pure PIL) takes ~110-180ms/frame, well
    over the 66ms budget for 15fps -- frames arrive slower than declared and
    irregularly. -framerate alone tells ffmpeg to assume constant-rate
    arrival and stamp every frame as exactly 1/fr regardless of how long it
    actually took, so the encoded clock silently drifts behind real time;
    whenever the writer catches up, a batch of those falsely-cheap-stamped
    frames flushes at once, which plays back as freeze -> speed-through ->
    freeze. -use_wallclock_as_timestamps stamps frames by real arrival time
    instead, and -fps_mode cfr/-r duplicates the last real frame to fill the
    real gaps, giving a steady constant-rate output that actually tracks
    wall-clock time.
    """
    fr = int(_cfg.get('FRAMERATE', 15))
    return subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-s', f'{FRAME_W}x{FRAME_H}', '-framerate', str(fr),
        '-use_wallclock_as_timestamps', '1',
        '-i', 'pipe:0',
        '-fps_mode', 'cfr', '-r', str(fr),
        '-c:v', 'libx264', '-preset', 'ultrafast', '-tune', 'zerolatency',
        '-vf', f'format=yuv420p',
        '-profile:v', 'high', '-level', '4.0',
        # GOP length sets the floor on HLS segment duration -- mediamtx can only
        # cut a segment at a keyframe. `-g fr*4` meant a keyframe every 4s, so
        # mediamtx produced 4s segments no matter what hlsSegmentDuration said,
        # and players targeting a short buffer ran dry between arrivals. Keep
        # this in step with mediamtx's hlsSegmentDuration.
        '-b:v', '1500k', '-g', str(max(1, int(fr * GOP_SECONDS))),
        '-rtsp_transport', 'tcp', '-f', 'rtsp', RTSP_URL
    ], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _resolve_avf_index():
    """Resolve the avfoundation index for the camera named in config.env.

    run-13: AVF_VIDEO_INDEX is POSITIONAL, and macOS enumerates Continuity
    Camera devices (a nearby iPhone) into the same list as the built-in camera.
    An iPhone that registers ahead of the built-in one silently turns
    "index 0" into someone's phone -- a family broadcast that switches source
    when a phone walks into the room, and dies when it walks out. Observed on
    this machine: an iPhone registered itself as "Aayah Camera" alongside the
    built-in FaceTime HD Camera.

    So resolve the index from AVF_DEVICE_NAME at open time instead of trusting
    a number written months ago. Falls back to the configured index if the
    named device is absent or the probe fails -- never worse than before.
    """
    want     = _cfg.get('AVF_DEVICE_NAME', '').strip()
    fallback = _cfg.get('AVF_VIDEO_INDEX', '0')
    if not want:
        return fallback
    try:
        out = subprocess.run(
            [FFMPEG, '-hide_banner', '-f', 'avfoundation',
             '-list_devices', 'true', '-i', ''],
            capture_output=True, text=True, timeout=15).stderr
    except Exception:
        return fallback

    in_video = False
    for line in out.splitlines():
        if 'AVFoundation video devices' in line:
            in_video = True
            continue
        if 'AVFoundation audio devices' in line:
            break
        if not in_video:
            continue
        m = re.search(r'\]\s*\[(\d+)\]\s+(.+?)\s*$', line)
        if m and m.group(2) == want:
            if m.group(1) != fallback:
                print(f"broadcast-api: '{want}' is at avfoundation index "
                      f"{m.group(1)}, not the configured {fallback} -- using "
                      f"{m.group(1)} (device list reordered, likely Continuity "
                      f"Camera)", file=sys.stderr, flush=True)
            return m.group(1)

    print(f"broadcast-api: camera '{want}' not found in avfoundation device "
          f"list; falling back to index {fallback}", file=sys.stderr, flush=True)
    return fallback


def _start_cam_reader():
    """Capture raw RGB frames from the macOS camera helper when installed."""
    if os.path.exists(_CAMERA_HELPER):
        return subprocess.Popen(
            [_CAMERA_HELPER],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )

    idx = _resolve_avf_index()
    fr  = int(_cfg.get('FRAMERATE', 15))
    return subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'avfoundation', '-thread_queue_size', '1024',
        '-framerate', str(fr),
        '-video_size', f'{FRAME_W}x{FRAME_H}',
        '-pixel_format', 'uyvy422',
        '-i', f'{idx}:none',
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-vf', f'scale={FRAME_W}:{FRAME_H}',
        'pipe:1'
    ], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def _read_detect_roi_raw():
    """The stored region including its on/off state, or None if never set.

    The box and whether it is APPLIED are separate facts. A region you spent
    time choosing should survive being switched off -- otherwise "off" means
    "draw it again", and nobody toggles something that costs them that.
    """
    try:
        with open(DETECT_ROI_FILE) as f:
            raw = f.read().strip()
        if not raw:
            return None
        d = json.loads(raw)
        box = {k: float(d[k]) for k in ('x', 'y', 'w', 'h')}
        if box['w'] <= 0 or box['h'] <= 0:
            return None
        box['on'] = bool(d.get('on', True))
        return box
    except Exception:
        # Every failure here widens to the full frame. A region is an optional
        # narrowing, and a corrupt file that silently cropped every alert to a
        # corner would be far worse than one that is ignored.
        return None



_mask_cache = {'at': 0.0, 'box': (False, None)}


def _privacy_mask_box():
    """The mask rectangle as fractions, or None. Cached for a second: this is
    consulted on every camera frame.

    MASKED IS THE DEFAULT. An absent file means on -- a region somebody took
    the trouble to draw is private until they say otherwise. Only the literal
    'false' turns it off.

    It reuses the detection region's geometry rather than storing a second
    rectangle: one region with a mode, since two would rot out of step. The
    raw reader is used so the mask still applies when the region is switched
    off for DETECTION -- different questions about the same box.
    """
    now = time.monotonic()
    if now - _mask_cache['at'] < 1.0:
        return _mask_cache['box']
    _mask_cache['at'] = now
    try:
        with open(PRIVACY_MASK_FILE) as f:
            on = f.read().strip() != 'false'
    except Exception:
        on = True
    if not on:
        _mask_cache['box'] = (False, None)
        return _mask_cache['box']
    # NO REGION AT ALL is not a failure -- it is the state of every node
    # before anyone draws a box, and defaulting to on must never black a
    # camera that has never had one. A region file that EXISTS and will not
    # parse is the different case below, and that one blacks.
    try:
        _present = os.path.getsize(DETECT_ROI_FILE) > 0
    except Exception:
        _present = False
    if not _present:
        _mask_cache['box'] = (False, None)
        return _mask_cache['box']
    box = None
    try:
        r = _read_detect_roi_raw()
        if r:
            x, y, w, h = (float(r['x']), float(r['y']),
                          float(r['w']), float(r['h']))
            if w > 0 and h > 0:
                box = (x, y, w, h)
    except Exception:
        box = None
    _mask_cache['box'] = (True, box)
    return _mask_cache['box']


# This lineage has no standalone blur: its mosaic lives inside CVProcessor
# (block_art.render_cloak_vec) and operates on the render, not on the raw
# frame the mask works from. So the mask carries its own, which is two
# resizes -- downscale with area averaging, upscale with nearest neighbour.
# Imported here rather than lazily at call time: a mask that discovers at
# frame 1 that it cannot pixelate should fall back to black immediately, not
# raise inside the capture thread.
try:
    import cv2 as _mask_cv2
except Exception:
    _mask_cv2 = None

_MASK_BLOCK = None


def _mask_block():
    try:
        return max(4, int(_cfg.get('BLUR_BLOCK', 24)))
    except Exception:
        return 24


def _mask_style():
    """'pixel' or 'black'. Black is the default and the stronger of the two.

    A mosaic is NOT equivalent to blacking out. It leaves coarse structure --
    how many people, where they are, when they move -- and block size is a
    judgement about how much of that is acceptable, not a guarantee. It is
    offered because a pixelated room still reads as a room while a black one
    reads as a fault, which is a real reason to want it; not as equal privacy.
    """
    try:
        with open(MASK_STYLE_FILE) as f:
            return 'pixel' if f.read().strip() == 'pixel' else 'black'
    except Exception:
        return 'black'


def _mask_mosaic(arr):
    """The mosaic, or None. None means the caller must fall back to BLACK --
    never to the clear picture."""
    global _MASK_BLOCK
    if _mask_cv2 is None:
        return None
    if _MASK_BLOCK is None:
        _MASK_BLOCK = _mask_block()
    try:
        h, w = arr.shape[:2]
        sw, sh = max(1, w // _MASK_BLOCK), max(1, h // _MASK_BLOCK)
        small = _mask_cv2.resize(arr, (sw, sh), interpolation=_mask_cv2.INTER_AREA)
        return _mask_cv2.resize(small, (w, h), interpolation=_mask_cv2.INTER_NEAREST)
    except Exception as exc:
        print('broadcast-api: mask mosaic failed, blacking instead: '
              f'{type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
        return None


def _apply_privacy_mask(raw):
    """Black out everything outside the region, on the frame everything else
    is derived from.

    On this lineage that is _cv_pump's `raw`: the recorder (_to_rec), the
    detector (observe) and the published picture (dst.write) all come from
    it, so masking there is the only placement where a clip cannot disagree
    with the switch. _drain_loop's cache is masked too, for the consumers
    that read it.

    Fails CLOSED, deliberately against the house rule for this geometry:
    every other reader widens on failure so a corrupt file cannot silently
    narrow what is watched, but the only unacceptable outcome here is showing
    the room while the switch says hidden.

    Off costs nothing -- raw is returned untouched, no copy.
    """
    try:
        on, box = _privacy_mask_box()
    except Exception:
        on, box = True, None
    if not on:
        return raw
    if box is None:
        return b'\x00' * FRAME_BYTES
    try:
        arr = np.frombuffer(raw, np.uint8).reshape(FRAME_H, FRAME_W, 3)
        fx, fy, fw, fh = box
        x = max(0, min(FRAME_W - 1, int(round(fx * FRAME_W))))
        y = max(0, min(FRAME_H - 1, int(round(fy * FRAME_H))))
        w = max(1, min(FRAME_W - x, int(round(fw * FRAME_W))))
        h = max(1, min(FRAME_H - y, int(round(fh * FRAME_H))))
        out = None
        if _mask_style() == 'pixel':
            out = _mask_mosaic(arr)
            if out is not None:
                out = np.ascontiguousarray(out)
        if out is None:
            # Either black was asked for, or the mosaic failed. Both end here:
            # the one thing this must never do is fall back to the clear room.
            out = np.zeros((FRAME_H, FRAME_W, 3), np.uint8)
        out[y:y + h, x:x + w] = arr[y:y + h, x:x + w]
        return out.tobytes()
    except Exception as exc:
        print('broadcast-api: privacy mask failed, blanking frame: '
              f'{type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
        return b'\x00' * FRAME_BYTES


def _read_privacy_mask():
    """Absent means MASKED -- see _privacy_mask_box. Only 'false' is off."""
    try:
        with open(PRIVACY_MASK_FILE) as f:
            return f.read().strip() != 'false'
    except Exception:
        return True


def _write_privacy_mask(enabled):
    os.makedirs(os.path.dirname(PRIVACY_MASK_FILE), exist_ok=True)
    with open(PRIVACY_MASK_FILE, 'w') as f:
        f.write('true' if enabled else 'false')
    _mask_cache['at'] = 0.0


def _drain_loop(cam_holder):
    """Continuously read camera frames into the shared cache; restart on EOF."""
    global _cam_frame, _cam_proc
    while True:
        try:
            raw = cam_holder[0].stdout.read(FRAME_BYTES)
            if len(raw) == FRAME_BYTES:
                raw = _apply_privacy_mask(raw)
                with _cam_frame_lock:
                    _cam_frame = raw
            else:
                time.sleep(2.0)
                try:
                    cam_holder[0].terminate()
                except Exception:
                    pass
                cam_holder[0] = _start_cam_reader()
                _cam_proc = cam_holder[0]
        except Exception:
            time.sleep(1.0)



def audio_filter_args():
    """Capture-side gain, shared by every publisher that opens the mic.

    Factored out when CV mode added a second publisher: two copies of a
    filter chain is two places for the gain to drift apart, and the one
    that drifts is always the one nobody is listening to.
    """
    chain = []
    raw_filter = str(_cfg.get('AUDIO_FILTER', '')).strip()
    gain_db_raw = str(_cfg.get('AUDIO_GAIN_DB', '')).strip()
    if raw_filter:
        chain.append(raw_filter)
    elif gain_db_raw:
        try:
            gain_db = float(gain_db_raw)
        except ValueError:
            print(f'broadcast-api: ignoring non-numeric AUDIO_GAIN_DB='
                  f'{gain_db_raw!r}', file=sys.stderr, flush=True)
        else:
            if gain_db:
                chain.append(f'volume={gain_db}dB,alimiter=limit=0.95')
    # The 48k/stereo guarantee lives HERE, not in -ar/-ac, and the difference
    # is not cosmetic: ffmpeg 8.1.2 refuses to open an avfoundation mic at all
    # when -ar or -ac appears anywhere in the command -- even as an output
    # option after -c:a, which is where it sat. Measured on ariana:
    #
    #   -f avfoundation -i ":Built-in Microphone" -t 1 -f null -    -> opens,
    #                                                    48000 Hz, stereo
    #   ... the same command plus -ar 48000 -ac 2                   -> "audio
    #                     format is not supported", input I/O error
    #
    # The publisher then died on input #1 on every attempt and took the
    # picture down with it, because one ffmpeg carries both -- which is why
    # this read as "Show does not trigger" rather than as an audio fault.
    # A filter is applied after the demuxer has already opened, so it can
    # state the same requirement without being able to cause this.
    chain.append('aformat=sample_rates=48000:channel_layouts=stereo')
    return ['-af', ','.join(chain)]


# ── CV mode ──────────────────────────────────────────────────────
#
# Show and hide are one ffmpeg: devices straight to RTSP, nothing in between.
# CV needs Python between the camera and the encoder, and combined A/V left no
# seam for that -- which is why Blur and Hide became buttons over nothing.
#
# The seam is reopened as a split rather than by reverting combined A/V:
#
#   ffmpeg A   avfoundation camera -> rawvideo on stdout
#   python     CVProcessor.process() per frame
#   ffmpeg B   rawvideo on stdin + the microphone -> RTSP
#
# Two AVFoundation clients, but on *different devices*. The deadlock this
# stack lost hours to was two clients contending for the CAMERA; the camera
# is opened once here, by A, and B only ever opens the microphone. Audio
# therefore survives CV mode instead of being dropped for it.
#
# Measured on ariana (i5-6287U, 2 physical cores) before any of this was
# wired: 43.3 ms median per frame at 1280x720, 65% of the 66.7 ms budget at
# 15fps. The reduced-resolution analysis path the Linux notes call for is not
# needed here.
_cv_procs  = []
_cv_thread = None
_cv_stop   = threading.Event()
# Live handle onto the running CVProcessor so /api/pipeline can report real
# faculty state (MOG2/Foveal/scene registration) instead of a fixed lamp
# strip that always reads the same regardless of what CV mode is actually
# doing -- the fleet's own rule ("a lamp that can never fail is
# indistinguishable from a broken one"). Cleared whenever the CV publisher
# stops, so a lamp reads unknown/off between CV sessions rather than
# showing a stale reading from the last one.
_cv_proc_instance = None


def _read_exact(src, n):
    """Read exactly n bytes, or return None at end of stream.

    An unbuffered pipe returns SHORT reads -- read(n) gives whatever has
    arrived, not n bytes. Treating a short read as end-of-stream stops the
    pump on its first frame, which is precisely what it did: zero frames
    through, no error, and a CV mode that published nothing while every
    process involved looked healthy.
    """
    buf = bytearray()
    while len(buf) < n:
        chunk = src.read(n - len(buf))
        if not chunk:
            return None                # real EOF
        buf += chunk
    return bytes(buf)


def _read_exact_deadline(src, n, timeout):
    """_read_exact with a wall-clock bound. Returns None on EOF or timeout.

    select() on the pipe rather than a read timeout: the camera leg can be
    alive, holding the device, and simply never delivering, which a blocking
    read cannot distinguish from slow.
    """
    buf = bytearray()
    end = time.monotonic() + timeout
    fd = src.fileno()
    while len(buf) < n:
        left = end - time.monotonic()
        if left <= 0:
            return None                # timed out, caller must clean up
        r, _, _ = select.select([fd], [], [], left)
        if not r:
            continue
        chunk = src.read(n - len(buf))
        if not chunk:
            return None                # real EOF
        buf += chunk
    return bytes(buf)


_OBSERVE_PERIOD = 1.0 / 5.0   # detection tap rate in plain Show / Hide
# Hide publishes this instead of the camera. Allocated once: it is written
# every frame, and a fresh 2.7MB of zeros per frame is pure waste.
_BLACK_FRAME = (b'\x00' * (FRAME_W * FRAME_H * 3))


def _cv_pump(src, dst, proc, first_raw=None, rec=None):
    """Read raw frames from A, process, write to B. Owns neither process.

    first_raw is the frame the caller already pulled off A to prove the
    camera session was open before it opened the microphone. It is a real
    frame of the room, not a probe, so it goes through the pipeline like
    any other rather than being thrown away.

    `rec` is the evidence recorder, and it gets the frame BEFORE any mode
    rendering -- unrendered in Show, un-blacked in Hide, un-annotated in CV.
    An alert clip should show the room, not show what the viewer happened to
    have selected when the cat walked through.
    """
    nbytes = FRAME_W * FRAME_H * 3
    dropped = 0
    pending = first_raw
    last_observe = [0.0]
    last_prune = [0.0]

    # The recorder is written from its OWN thread, behind a bounded queue.
    #
    # Writing to it inline looks harmless and is not: rec.stdin is a pipe
    # opened with bufsize=0, so a write blocks once the pipe fills, and a
    # block here stops the pump -- which stops the picture, stops the
    # detector, and shows up as "capture stalled" with nothing pointing at
    # the recorder. The evidence leg must never be able to do that; it is
    # the least important consumer of this frame and it was the only one
    # able to halt the rest.
    #
    # Bounded at 8 frames (~half a second at 15fps). Full means the recorder
    # is behind, and the frame is DROPPED rather than waited on: a clip with
    # a dropped frame is still evidence, a stalled stream is an outage.
    rec_q = queue.Queue(maxsize=8) if rec is not None else None
    rec_dropped = [0]

    def _rec_writer():
        while True:
            buf = rec_q.get()
            if buf is None:
                break
            try:
                rec.stdin.write(buf)
            except Exception:
                break      # recorder died; stop feeding a closed pipe

    if rec_q is not None:
        threading.Thread(target=_rec_writer, daemon=True,
                         name='cv-rec-writer').start()

    def _to_rec(buf):
        """Never let the recorder take the picture down with it."""
        if rec_q is None:
            return
        try:
            rec_q.put_nowait(buf)
        except queue.Full:
            rec_dropped[0] += 1
            if rec_dropped[0] in (1, 100, 1000) or rec_dropped[0] % 5000 == 0:
                print('broadcast-api: evidence recorder behind, dropped '
                      f'{rec_dropped[0]} frame(s)', file=sys.stderr, flush=True)

    def _prune():
        """Age out old segments. mediamtx had recordDeleteAfter; writing the
        files ourselves means doing this ourselves, and an unbounded rolling
        recording fills a disk at about 20MB an hour."""
        now = time.monotonic()
        if now - last_prune[0] < 300:
            return
        last_prune[0] = now
        try:
            keep = float(_cfg.get('RECORD_RETENTION_H', 6)) * 3600.0
            root = (str(_cfg.get('RECORD_DIR', '')).strip()
                    or os.path.join(STATE_DIR, 'rec', 'cam'))
            cutoff = time.time() - keep
            for f in os.listdir(root):
                if not f.endswith('.mp4'):
                    continue
                fp = os.path.join(root, f)
                try:
                    if os.path.getmtime(fp) < cutoff:
                        os.unlink(fp)
                except Exception:
                    pass
        except Exception:
            pass
    while not _cv_stop.is_set():
        if pending is not None:
            raw, pending = pending, None
        else:
            raw = _read_exact(src, nbytes)
            if raw is None:
                break                  # A exited or was killed
        # BEFORE the branch below: _to_rec, the detector's observe() and the
        # published dst.write() are all derived from this one buffer, so one
        # call here is what makes the mask a property of the frame rather
        # than of three remembered call sites.
        raw = _apply_privacy_mask(raw)
        try:
            # The real frame, before anything renders over it. Every mode
            # feeds the recorder the same picture of the room.
            _to_rec(raw)
            _prune()
            frame = np.frombuffer(raw, np.uint8).reshape(FRAME_H, FRAME_W, 3)

            # Plain Show: the viewer asked for the unaltered camera, so render
            # nothing and write the frame through byte-for-byte. Detection
            # still runs, throttled, off the same pre-render tap process()
            # publishes to -- which is why the snapshot is a photo of the room
            # and not a CV render. 5Hz is ample for a detector that runs at
            # CV_DETECT_HZ, and it keeps the cost of watching Show near zero.
            # Hide means "do not show me the picture", not "stop watching the
            # room" -- both cameras are in one house and the people in it are
            # not hiding from each other. So publish black and keep the
            # detector fed, which is what the Linux node has always done. The
            # camera stays open; that is the cost of watching anything at all.
            if _mode == 'hide':
                now = time.monotonic()
                if now - last_observe[0] >= _OBSERVE_PERIOD:
                    last_observe[0] = now
                    proc.set_foveal(True)
                    proc.set_motion_alerts('motion' in _read_notify_classes())
                    _r = _read_detect_roi()
                    proc.set_roi((_r['x'], _r['y'], _r['w'], _r['h']) if _r else None)
                    proc.observe(frame)
                dst.write(_BLACK_FRAME)
                continue

            if _mode == 'show' and not _cv_blur_mode:
                now = time.monotonic()
                if now - last_observe[0] >= _OBSERVE_PERIOD:
                    last_observe[0] = now
                    # Foveal ON for the detector regardless of the viewer's
                    # checkbox: it is what runs MOG2, and MOG2 is what gives
                    # each detection its fg_consistency. The notifier's motion
                    # gate is inert without it -- every detection reports the
                    # neutral 1.00 and furniture alerts forever, which is the
                    # failure tanzania had. Costs the picture nothing here:
                    # this branch renders nothing, it writes `raw` through.
                    proc.set_foveal(True)
                    proc.set_motion_alerts('motion' in _read_notify_classes())
                    _r = _read_detect_roi()
                    proc.set_roi((_r['x'], _r['y'], _r['w'], _r['h']) if _r else None)
                    proc.observe(frame)
                dst.write(raw)
                continue

            proc.set_motion_alerts('motion' in _read_notify_classes())
            proc.set_blur(_cv_blur_mode)  # re-read every frame, same as feed mode
            # The detection region, same cadence: a region changed in the
            # panel applies to the next frame, not the next restart.
            _r = _read_detect_roi()
            proc.set_roi((_r['x'], _r['y'], _r['w'], _r['h']) if _r else None)
            proc.set_foveal(_cv_foveal_mode)  # ditto -- the real gate, not a stub
            proc.set_night(_mode == 'night')  # ditto
            _t_cv = time.perf_counter()
            out, _meta = proc.process(frame)
            _cv_obs_record((time.perf_counter() - _t_cv) * 1000.0)
            dst.write(np.ascontiguousarray(out).tobytes())
        except BrokenPipeError:
            break                      # B exited; the loop above will notice
        except Exception as exc:
            # A frame that will not process must not take the stream down.
            # Pass it through untouched and keep going -- a brief unprocessed
            # frame is a far better failure than a stopped feed.
            dropped += 1
            if dropped in (1, 10, 100):
                print(f'broadcast-api: CV frame passthrough after '
                      f'{type(exc).__name__}: {exc} [{dropped} so far]',
                      file=sys.stderr, flush=True)
            try:
                dst.write(raw)
            except Exception:
                break


def _mic_input_args(audio_idx):
    """Input args for the capture encoder's audio leg: the real mic if it can
    be opened, silence if it cannot.

    The mic is NOT exclusively ours. The roomaudio leg captures the same
    device through CoreAudio (SoX), and this encoder asks AVFoundation for it
    at the same time. Two capture clients on one device is the failure this
    tree already documents for the camera, and on ariana it shows up as
        [in#1] audio format is not supported
        Error opening input file :Built-in Microphone.
    -- on input #1, which kills the WHOLE command, including input #0, which
    is the picture. That is how a microphone conflict became "the camera is
    broken": video died at 03:14 and the capture spun relaunching for hours
    while the camera itself was healthy (VDCAssistant logged FrameCompleted=93
    on the legs being discarded).

    So probe first and degrade on purpose. An audio fault must cost the audio
    track, never the video track. When the mic is free this is a 1s no-op and
    behaviour is unchanged; when it is not, the family still sees the room.
    """
    mic = ['-f', 'avfoundation', '-thread_queue_size', '1024',
           '-i', f':{audio_idx}']
    try:
        probe = subprocess.run(
            [FFMPEG, '-hide_banner', '-loglevel', 'error',
             '-f', 'avfoundation', '-i', f':{audio_idx}',
             '-t', '1', '-f', 'null', '-'],
            stdin=subprocess.DEVNULL, capture_output=True, timeout=15)
        err = (probe.stderr or b'').decode('utf-8', 'replace')
        if probe.returncode == 0 and 'not supported' not in err:
            return mic
        print('broadcast-api: microphone unavailable to the capture encoder '
              '(%s); publishing a silent audio track so the picture stays up'
              % (err.strip().splitlines()[-1] if err.strip() else
                 'rc=%s' % probe.returncode),
              file=sys.stderr, flush=True)
    except Exception as exc:
        print('broadcast-api: microphone probe failed (%s); publishing a '
              'silent audio track' % type(exc).__name__,
              file=sys.stderr, flush=True)
    # Silence, generated rather than captured. Still a real 48k stereo track,
    # so the muxer, the AAC encoder and every downstream reader see exactly
    # the stream shape they saw before.
    return ['-f', 'lavfi',
            '-i', 'anullsrc=channel_layout=stereo:sample_rate=48000']


def _start_cv_publisher(mode='cv'):
    """Camera -> CVProcessor -> RTSP, with the microphone joined at the muxer."""
    global _cv_thread, _cv_proc_instance
    if _cv_procs:
        # A previous pair should always have been stopped by the caller
        # before this runs, but the retry loop in _writer_loop re-enters
        # this function on the same stale spawn_mode without rechecking
        # _mode_generation, so it's possible to get here with a live pair
        # still tracked. Overwriting _cv_procs below would orphan it --
        # observed live as a leaked camera-leg ffmpeg, still holding the
        # camera and still being read by a pump thread nothing else
        # referenced anymore. Stop first, unconditionally, so this
        # function can never leak regardless of how it got called twice.
        _stop_cv_publisher()
    # Night mode captures at a genuinely lower framerate rather than the
    # normal one -- AVFoundation's own auto-exposure lengthens the exposure
    # window per frame as the requested rate drops, which is real long
    # exposure, not a digital simulation of it. The output stays honestly
    # choppy at that same rate rather than faking smoothness with frame
    # duplication: an old night-vision device looks like this too.
    if mode == 'night':
        fr = int(_cfg.get('NIGHT_FPS', 5))
    else:
        fr = int(_cfg.get('FRAMERATE', 15))
    video_idx = _resolve_avf_index()
    audio_idx = str(_cfg.get('AUDIO_DEVICE', 'Built-in Microphone')).strip() \
        or 'Built-in Microphone'
    rtsp_port = str(_cfg.get('RTSP_PORT', '8554')).strip() or '8554'
    rtsp_url = f'rtsp://127.0.0.1:{rtsp_port}/cam'

    import cv_processor as _cvp
    # Detection off means off -- in every mode, not just Show. Show already
    # answers to this by spawning the combined publisher instead of the split
    # pipeline, but CV and Night build a processor regardless, and a processor
    # with a detector runs one. Build it blind instead, so the switch stops
    # the work rather than only the alerts. Toggling bumps _mode_generation,
    # which rebuilds the publisher, so it takes effect immediately.
    _proc_cfg = dict(_cfg)
    if not _detect_always_on():
        _proc_cfg['CV_DETECT_ENABLED'] = '0'
    proc = _cvp.CVProcessor(_proc_cfg)
    _cv_proc_instance = proc

    a = subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'avfoundation', '-thread_queue_size', '1024',
        '-framerate', str(fr),
        '-video_size', f'{FRAME_W}x{FRAME_H}',
        '-pixel_format', 'uyvy422',
        '-use_wallclock_as_timestamps', '1',
        '-i', f'{video_idx}:none',
        # rgb24, NOT bgr24. Every consumer downstream already assumes RGB --
        # cv_notify converts RGB->BGR at the JPEG boundary, cv_processor does
        # its tone work in RGB->LAB, and cv_detect passes the frame to YOLO
        # with swapRB=False, which is correct only for RGB. The capture was the
        # one place saying BGR, so it fed every one of them mirrored channels:
        # alert photos came out with blue skin, and the detector was scoring a
        # colour-swapped image the whole time.
        '-f', 'rawvideo', '-pix_fmt', 'rgb24', 'pipe:1',
    ], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
       stderr=_open_ffmpeg_log(), bufsize=0)

    # A and B each open their own AVFoundation session (A: camera, B: mic --
    # split so the video leg can be piped through CVProcessor while audio
    # passes straight to the encoder). Opening both at once leaves B's
    # mic-only session failing fast with "audio format is not supported" /
    # "Input/output error" while A's camera session is still completing its
    # AVFoundation startup -- two concurrent AVCaptureSession opens racing.
    # B is the leg holding RTSP, so when B dies the whole publisher dies and
    # the viewer shows static with a camera that is working fine.
    #
    # This used to be `time.sleep(1.0)`. A sleep is a bet on how long a
    # capture session takes to open on a machine whose load we do not
    # control, and the bet was calibrated against one framerate but taken at
    # two: night asks for NIGHT_FPS (5) and won it, cv asks for FRAMERATE
    # (15) under a YOLO pass and lost it every time -- which is exactly the
    # shape the bug had, night working and cv publishing nothing.
    #
    # A's FIRST DELIVERED FRAME is not a bet. A frame came out of the
    # session, so the session is open; there is nothing left to race.
    # BOUNDED. An unbounded wait here is not a gate, it is a second way to
    # hang: when the camera is not free -- the very case this exists to catch
    # -- A stays alive and silent, this function never returns, _cv_procs is
    # never assigned, and no teardown path can find A to kill it. That leaked
    # two camera legs at once on ariana within minutes of the gate landing.
    first_raw = _read_exact_deadline(a.stdout, FRAME_W * FRAME_H * 3,
                                     float(_cfg.get('CV_FIRST_FRAME_TIMEOUT_S', 8)))
    if first_raw is None:
        # No frame in time: either A died, or something else still holds the
        # camera. Either way B must not be spawned -- it would only add a
        # second failure to explain -- and A must not be left running.
        print('broadcast-api: CV capture: camera leg produced no frame in '
              'time; not opening the microphone', file=sys.stderr, flush=True)
        try: _kill_hard(a)
        except Exception: pass
        _cv_proc_instance = None
        return None

    b = subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        # rgb24, matching the capture and _start_publisher() above. These two
        # publishers disagreed -- one declared rgb24, this one bgr24, against
        # one bgr24 capture -- so the live picture was correct on this path and
        # would have been channel-swapped on the other.
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-s', f'{FRAME_W}x{FRAME_H}', '-framerate', str(fr),
        '-use_wallclock_as_timestamps', '1',
        '-i', 'pipe:0',
        *_mic_input_args(audio_idx),
        '-map', '0:v:0', '-map', '1:a:0',
        '-c:v', 'libx264', '-preset', 'ultrafast', '-tune', 'zerolatency',
        '-vf', 'format=yuv420p', '-profile:v', 'high', '-level', '4.0',
        '-b:v', '1500k', '-g', str(fr),
        '-c:a', 'aac', '-b:a', '96k',
        *audio_filter_args(),
        '-rtsp_transport', 'tcp', '-f', 'rtsp', rtsp_url,
        # NO second output here: roomaudio is published by its own leg (the
        # SoX -> libopus publisher), and two publishers on one mediamtx path
        # means mediamtx evicts one of them -- 289 "closing existing
        # publisher" lines in this node's log, 15 in the last 200. Eviction
        # breaks this process's output pipe, and because ONE ffmpeg carries
        # both outputs, the broken audio output killed the video output with
        # it. That is the cascade that left the family stream 404 for hours
        # while the camera was healthy. The picture must not depend on an
        # audio path it does not need.
    ], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
       stderr=_open_ffmpeg_log(), bufsize=0)

    # ── THE EVIDENCE RECORDER ──────────────────────────────────────
    # A third leg, fed the REAL frame, writing one-minute segments straight
    # to disk. cv_notify cuts alert clips out of these.
    #
    # WHY NOT mediamtx's own recorder, which is free: because it can only
    # record what is PUBLISHED, and in Hide what is published is black. The
    # clip arrived as a black rectangle while the stills showed the animal --
    # the alert's own evidence going blank in the mode you are most likely to
    # be in when you want it.
    #
    # WHY NOT a second mediamtx path carrying the real picture: mediamtx
    # serves every path it holds over HLS, and hlsAddress is :8888 on all
    # interfaces. That path would be fetchable from the LAN while Hide is on,
    # which would quietly undo the one control whose whole job is that nobody
    # sees the room. Straight to disk has no serving surface to secure.
    #
    # THE COST IS REAL AND IT IS CPU: this is a second libx264 encode on a
    # node that also runs YOLO. ultrafast/zerolatency keeps it cheap, but if
    # the CV budget starts being missed, this is the first thing to look at.
    rec_root = (str(_cfg.get('RECORD_DIR', '')).strip()
                or os.path.join(STATE_DIR, 'rec', 'cam'))
    os.makedirs(rec_root, exist_ok=True)
    r = subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-s', f'{FRAME_W}x{FRAME_H}', '-framerate', str(fr),
        '-use_wallclock_as_timestamps', '1',
        '-i', 'pipe:0',
        '-an',
        '-c:v', 'libx264', '-preset', 'ultrafast', '-tune', 'zerolatency',
        '-pix_fmt', 'yuv420p',
        # Config, not a literal. The evidence leg is not the feed: it trades
        # bitrate for a rolling window measured in hours, and the right trade
        # differs per node -- this one has 369G free, tanzania does not.
        '-b:v', str(_cfg.get('RECORD_BITRATE', '1500k')).strip() or '1500k',
        '-g', str(fr),
        '-f', 'segment',
        '-segment_time', str(int(float(_cfg.get('RECORD_SEGMENT_S', 60)))),
        '-segment_format', 'mp4',
        # Fragmented, so a segment that is still being written -- or one cut
        # short by a mode change -- is still playable. The clip cutter treats
        # the newest segment as open-ended, which is only true if a partial
        # file can be read at all.
        '-segment_format_options', 'movflags=+frag_keyframe+empty_moov',
        '-reset_timestamps', '1', '-strftime', '1',
        os.path.join(rec_root, '%Y-%m-%d_%H-%M-%S.mp4'),
    ], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
       stderr=_open_ffmpeg_log(), bufsize=0)

    _cv_stop.clear()
    _cv_thread = threading.Thread(target=_cv_pump,
                                  args=(a.stdout, b.stdin, proc, first_raw, r),
                                  daemon=True, name='cv-pump')
    _cv_thread.start()

    _cv_procs[:] = [a, b, r]
    print(f'broadcast-api: CV capture: camera={video_idx} -> CVProcessor -> '
          f'{rtsp_url} (audio={audio_idx})', file=sys.stderr, flush=True)
    return b        # B holds the RTSP socket, so B is what the watchdog polls


def _stop_cv_publisher():
    global _cv_proc_instance
    _cv_stop.set()
    for pr in _cv_procs:
        try: _kill_hard(pr)
        except Exception: pass
    _cv_procs[:] = []
    # Drop the reference AND retire its detector thread. Dropping alone left
    # the daemon running on a stale frame, which is what made "detection off"
    # keep producing detections.
    try:
        if _cv_proc_instance is not None:
            _cv_proc_instance.stop()
    except Exception:
        pass
    _cv_proc_instance = None
    # _kill_hard() waits for the OS process to exit, but CoreAudio's release
    # of the microphone lags a moment behind that -- observed live as the
    # very next avfoundation open (a mode switch back into cv/night) failing
    # fast with "Input/output error" on the mic, intermittently, exactly the
    # signature of a device not yet free rather than a real incompatibility.
    # This settle window sits in the one function every teardown path
    # already funnels through, so it covers all of them.
    time.sleep(0.8)


def _start_combined_av_publisher(mode='show'):
    """
    One AVFoundation session for camera + microphone.

    The resulting RTSP track contains:
      video: H.264 1280x720 @ configured FPS
      audio: AAC 48 kHz stereo @ 96 kb/s

    This deliberately bypasses the old Python frame-processing writer
    path. The API server remains alive for control/message endpoints,
    while media capture/publishing is handled by this single process.
    """
    fr = int(_cfg.get('FRAMERATE', 15))
    video_idx = _resolve_avf_index()
    audio_idx = str(
        _cfg.get('AUDIO_DEVICE', 'Built-in Microphone')
    ).strip() or 'Built-in Microphone'

    rtsp_port = str(_cfg.get('RTSP_PORT', '8554')).strip() or '8554'
    rtsp_url = f'rtsp://127.0.0.1:{rtsp_port}/cam'

    # Optional capture-side gain. A room mic is quiet by nature -- measured
    # here at roughly -39 dB mean -- and a browser cannot make up the
    # difference, because an <audio> element's volume caps at 1.0 and only
    # ever attenuates. Raising it at the source is the only thing that makes
    # every client louder.
    #
    # Two knobs, both off by default so an existing node sounds exactly as it
    # did until someone opts in:
    #
    #   AUDIO_GAIN_DB   fixed gain, limited so that boosting a quiet room
    #                   does not clip when someone finally speaks near the
    #                   mic. alimiter, not hard clipping, because clipped
    #                   speech is worse than quiet speech.
    #   AUDIO_FILTER    raw ffmpeg -af chain for anything more involved,
    #                   e.g. dynaudnorm for constant perceived loudness.
    #                   Wins if both are set.
    # Hidden means the devices are not opened at all, not that something is
    # drawn over the picture. A client-side overlay hides the feed in one
    # browser tab while the real stream stays available to every other viewer,
    # to camdash, and to anyone who requests the HLS URL directly -- which is
    # the opposite of what a control called Hide should do.
    #
    # Publishing generated black instead means the camera is genuinely closed:
    # its indicator light goes out, which no overlay can achieve, and the
    # microphone is closed with it. Black also costs almost nothing to encode,
    # unlike static, which is incompressible by construction.
    if mode == 'hide':
        source = [
            '-f', 'lavfi',
            '-i', f'color=c=black:s={FRAME_W}x{FRAME_H}:r={fr}',
            '-f', 'lavfi',
            '-i', 'anullsrc=channel_layout=stereo:sample_rate=48000',
            '-map', '0:v:0',
            '-map', '1:a:0',
        ]
    else:
        source = [
            # PICTURE. Wallclock-stamped, because this camera's own
            # timestamps freeze; that is a video problem with a video fix.
            '-f', 'avfoundation',
            # Input thread queue. ffmpeg's default is 8 packets: when the
            # muxer/encoder side stalls even briefly, avfoundation packets
            # overflow that queue and are DROPPED at the source -- measured
            # on this rig as 78% silence in the published room audio,
            # arriving as ~300ms bursts every ~1.3s, while a dryer was
            # running and the room was anything but silent.
            '-thread_queue_size', '1024',
            '-framerate', str(fr),
            '-video_size', f'{FRAME_W}x{FRAME_H}',
            '-pixel_format', 'uyvy422',
            '-use_wallclock_as_timestamps', '1',
            # ONE avfoundation input carrying both, which is how this ran
            # before and the only arrangement measured delivering real time.
            #
            # Splitting the microphone onto a SECOND avfoundation input --
            # textbook advice, and what every conferencing stack does -- was
            # measured here as a quarter of real time at the source: the
            # unresampled 'cam' output ran at 25% while the room-audio output
            # only reached 99% because aresample was padding the shortfall
            # with silence (43% of its windows below -60dB, which is what the
            # pulsing actually was). Two AVFoundation sessions in one ffmpeg
            # process is the fragile arrangement amira's own capture notes
            # warn about; on this rig it starves the audio session rather
            # than freeing it.
            # CAMERA ONLY. The microphone is captured by its own process
            # (_mic_publisher_loop below) and published to 'roomaudio'.
            #
            # Measured on this rig, decoding the captured samples rather than
            # trusting container duration: sharing ONE AVFoundation session
            # between camera and mic delivered ~20% of the audio -- a 62s
            # capture held 12.3s of real samples, timestamps stretched over
            # the full minute, and aresample padded the missing 80% with
            # silence. That padding is the 6-7Hz metallic pulse. The same mic,
            # alone in its own process, delivered ~89%. No amount of codec,
            # bitrate, FEC or resampler tuning could reach audio that was
            # never captured.
            '-i', f'{video_idx}:none',
            '-map', '0:v:0',
        ]

    audio_filter = audio_filter_args()

    cmd = [
        FFMPEG,
        '-hide_banner',
        '-loglevel', 'warning',
        *source,

        '-c:v', 'libx264',
        '-preset', 'ultrafast',
        '-tune', 'zerolatency',
        '-vf', 'format=yuv420p',
        '-profile:v', 'high',
        '-level', '4.0',
        '-b:v', '1500k',
        '-g', str(fr),

        # No audio track on 'cam' at all: this process no longer opens the
        # microphone. Sound lives on 'roomaudio', which is where the viewer
        # already takes it from (WHEP for Play and 2-Way alike). The cost is
        # that the HLS fallback path carries a silent picture on any browser
        # that cannot do WebRTC -- a fair trade for audio that is continuous
        # rather than 20% present.
        '-an',

        '-rtsp_transport', 'tcp',
        '-f', 'rtsp',
        rtsp_url,
    ]

    print(
        'broadcast-api: combined AV capture: '
        f'video={video_idx} audio={audio_idx} -> {rtsp_url}',
        file=sys.stderr,
        flush=True,
    )

    return subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=_open_ffmpeg_log(),
    )


# ── MICROPHONE PUBLISHER: its own process, its own AVFoundation session ──
#
# Kept deliberately separate from the camera capture. See the note in
# _start_combined_av_publisher: one session serving both devices loses ~80% of
# the audio on this hardware, and every downstream fix was tuning samples that
# had already been dropped.
#
# Supervised the same way the talkback player is: a patient loop, because the
# mic can be momentarily unavailable while a previous session releases it, and
# a one-shot spawn would leave the room silent until someone noticed.
_mic_proc = None


# ── ROOM AUDIO FAN-OUT ────────────────────────────────────────────────
#
# Listening is a progressive MP3 served straight from this process, and the
# reason is measurement, not taste. Against the mediamtx path, same mic and
# same minute: 8% of windows below -60dB instead of 42-51%, envelope
# periodicity 0.16 (noise) instead of 0.38-0.56, and a mean level 27dB higher
# WITHOUT the +12dB capture gain the old path needed. The old chain was mostly
# transmitting padded silence, and the padding is what "staccato" was.
#
# What this drops, deliberately: RTSP, mediamtx, HLS segmenting, playlists,
# hls.js, MSE, WebRTC, and the Web Audio graph -- for LISTENING. A browser has
# had a buffered audio decoder for twenty years and it does not stutter.
# 2-Way still runs on WebRTC, where real-time delivery is the entire point.
#
# The microphone is opened ONCE and feeds both: MP3 to this hub over a pipe,
# Opus to mediamtx for the WebRTC leg. A device with two owners has none.
_MIC_CHUNK = 4096
_MIC_QUEUE_CHUNKS = 64


class _MicHub:
    """One capture, many listeners. A slow listener never stalls the others."""

    def __init__(self):
        self._subs = set()
        self._lock = threading.Lock()

    def publish(self, buf):
        with self._lock:
            subs = list(self._subs)
        for q in subs:
            try:
                q.put_nowait(buf)
            except queue.Full:
                # Drop this listener's OLDEST audio rather than block the
                # reader thread, which would back up into ffmpeg and lose
                # samples at the capture -- the exact failure being fixed.
                try:
                    q.get_nowait()
                    q.put_nowait(buf)
                except Exception:
                    pass

    def subscribe(self):
        q = queue.Queue(maxsize=_MIC_QUEUE_CHUNKS)
        with self._lock:
            self._subs.add(q)
        return q

    def unsubscribe(self, q):
        with self._lock:
            self._subs.discard(q)

    def listeners(self):
        with self._lock:
            return len(self._subs)


_mic_hub = _MicHub()






def _notch_args():
    """Bandreject filters, from state/notches.json.

    JSON rather than a config.env string because each notch needs a REASON
    recorded beside it. A bare list of frequencies in an env var becomes
    undeletable within a month: nobody can remember which ones are still
    needed, so they all stay forever, quietly carving holes in the audio long
    after whatever caused them was fixed.

    Format:

      {"notches": [
         {"range": [3050, 3100], "note": "why", "added": "2026-09-04"},
         {"center": 8000, "width": 30, "note": "why"}
       ]}

    A range is the honest form when the artifact wanders -- a resonance is
    never one frequency for long, and chasing it with single notches means
    adding one every time it moves.

    Anything malformed is skipped with a warning rather than taking the
    capture down: a bad filter list must not cost the room its audio.
    """
    doc = _read_notches()
    args = []
    for item in doc.get('notches', []):
        # A notch can be turned OFF without deleting it -- bypassed for
        # comparison without losing the entry's history. Absent key =
        # enabled, so every pre-existing entry (none of which ever carried
        # this field) keeps behaving exactly as before.
        if item.get('enabled', True) is False:
            continue
        try:
            if 'range' in item:
                lo, hi = [float(v) for v in item['range']]
                if hi <= lo:
                    raise ValueError('range is not ascending')
                centre, width = (lo + hi) / 2.0, hi - lo
            else:
                centre = float(item['center'])
                width = float(item.get('width', 20))
            args += ['bandreject', '%.1f' % centre, '%.1fh' % width]
        except Exception as exc:
            print(f'broadcast-api: skipping notch {item!r}: {exc}',
                  file=sys.stderr, flush=True)
    return args


NOTCHES_FILE = os.path.join(ROOT, 'state', 'notches.json')


def _read_notches():
    try:
        with open(NOTCHES_FILE) as f:
            doc = json.load(f) or {}
    except Exception:
        doc = {}
    doc.setdefault('notches', [])
    return doc


def _write_notches(doc):
    with open(NOTCHES_FILE, 'w') as f:
        json.dump(doc, f)


def _notches_response(doc):
    return json.dumps({'notches': doc.get('notches', [])}), 200, {'Content-Type': 'application/json'}


def _bump_mode_generation():
    # Same trick /api/cv-blur-mode uses: bumping this under _mode_lock makes
    # _writer_loop notice and restart the combined AV publisher, which
    # rebuilds _mic_capture_cmd() (and therefore _notch_args()) from
    # scratch on its next spawn. Notches have no separate reload path of
    # their own on this node -- this IS the reload path.
    global _mode_generation
    with _mode_lock:
        _mode_generation += 1


@app.route('/api/notches', methods=['GET'])
def notches_get():
    """The notch filter database, for the Settings submenu. Ported from
    Tanzania's /api/notches (see broadcast-api there) -- same envelope, same
    bulk/per-entry PATCH split, no master switch (a sticky master that
    silenced everything AND blocked hand-picking individual entries while
    off was found to be a bug on Tanzania and removed there before this
    port happened)."""
    return _notches_response(_read_notches())


@app.route('/api/notches', methods=['POST'])
def notches_post():
    """Add one notch: {"center": Hz, "width": Hz, "note": "why"} or
    {"range": [lo, hi], "note": "why"}. Validated rather than trusted -- a
    bad entry must not take the room's audio down. Applies on the next
    capture rebuild (see _bump_mode_generation)."""
    try:
        body = json.loads(request.get_data(as_text=True) or '{}')
    except Exception:
        abort(400)
    note = str(body.get('note', '')).strip()[:200] or 'added from Settings'
    entry = {'note': note, 'added': time.strftime('%Y-%m-%d')}
    try:
        if 'range' in body:
            lo, hi = float(body['range'][0]), float(body['range'][1])
            if not (20 <= lo < hi <= 20000):
                abort(400)
            entry['range'] = [lo, hi]
        else:
            c = float(body['center'])
            w = float(body.get('width', 20))
            if not (20 <= c <= 20000) or not (1 <= w <= 500):
                abort(400)
            entry['center'], entry['width'] = c, w
    except (KeyError, TypeError, ValueError, IndexError):
        abort(400)
    doc = _read_notches()
    doc['notches'].append(entry)
    try:
        _write_notches(doc)
    except Exception as e:
        print(f'broadcast-api: notches write failed: {e}', flush=True)
        abort(500)
    _bump_mode_generation()
    return _notches_response(doc)


@app.route('/api/notches', methods=['DELETE'])
def notches_delete():
    """Remove one notch by its index in the current list (?i=N)."""
    try:
        i = int(request.args.get('i', ''))
    except (TypeError, ValueError):
        abort(400)
    doc = _read_notches()
    if not (0 <= i < len(doc['notches'])):
        abort(404)
    doc['notches'].pop(i)
    try:
        _write_notches(doc)
    except Exception as e:
        print(f'broadcast-api: notches write failed: {e}', flush=True)
        abort(500)
    _bump_mode_generation()
    return _notches_response(doc)


@app.route('/api/notches', methods=['PATCH'])
def notches_patch():
    """Toggle a notch's enabled state, body {"enabled": bool}.

    With ?i=N: one entry, bypass it without deleting it. WITHOUT ?i: a BULK
    action -- sets every entry to the same enabled value in one request
    ("Turn on all" / "Turn off all"). Ported from Tanzania's final design;
    an earlier sticky-master-switch version was replaced there because it
    silenced everything AND blocked hand-picking individual entries while
    off -- a bulk action has no state of its own to fight."""
    try:
        body = json.loads(request.get_data(as_text=True) or '{}')
        enabled = bool(body['enabled'])
    except (TypeError, ValueError, KeyError):
        abort(400)
    doc = _read_notches()
    i_raw = request.args.get('i')
    if i_raw is None:
        for item in doc['notches']:
            item['enabled'] = enabled
    else:
        try:
            i = int(i_raw)
        except ValueError:
            abort(400)
        if not (0 <= i < len(doc['notches'])):
            abort(404)
        doc['notches'][i]['enabled'] = enabled
    try:
        _write_notches(doc)
    except Exception as e:
        print(f'broadcast-api: notches write failed: {e}', flush=True)
        abort(500)
    _bump_mode_generation()
    return _notches_response(doc)


def _notch_center_hz(item):
    if 'range' in item:
        lo, hi = item['range']
        return (float(lo) + float(hi)) / 2.0
    return float(item.get('center', 0))


@app.route('/api/notches/sort', methods=['POST'])
def notches_sort():
    """Reorder the list by centre frequency. Order has no effect on what's
    audible (SoX applies the bandreject chain in sequence regardless of
    which one is listed first), so this does NOT bump the mode generation
    -- nothing to reapply, just a list re-sequence."""
    doc = _read_notches()
    doc['notches'].sort(key=_notch_center_hz)
    try:
        _write_notches(doc)
    except Exception as e:
        print(f'broadcast-api: notches write failed: {e}', flush=True)
        abort(500)
    return _notches_response(doc)


def _mic_capture_cmd(mode):  # noqa: ARG001 -- see MODE DOES NOT GATE below
    """Capture ONLY, with SoX. Raw PCM on stdout. No encoders, no sockets.

    `mode` is accepted and deliberately unused: the publisher loop keys its
    rebuild on the mode generation (which is also the notch reload path), so
    the argument still documents what triggers a respawn. It must NOT be used
    to gate the microphone again.

    SOX RATHER THAN FFMPEG, AND THIS IS NOT A PREFERENCE.

    ffmpeg's avfoundation AUDIO input is broken on macOS and has been for a
    decade: tickets #4437 and #4513, periodic dropouts with no error printed,
    worse while other audio is active, caused by allocating and destroying
    buffers instead of reusing a ring buffer with a QUEUE_SIZE hardcoded at 4.

    Measured here rather than taken on faith. ffmpeg reading this microphone
    delivered 5-6 seconds of audio per 30 seconds of wall clock -- about 20% --
    with no silence padding and no error, which is exactly what "ugly loud
    bursts staggered with silence" sounds like. It stayed at 20% through every
    structural fix tried against it: splitting the mic off the camera, giving
    each encoder its own process, non-blocking fan-out, TCP to UDP. None of
    them mattered, because none of them was the input.

    SoX capturing the SAME device through CoreAudio: 20.000 seconds of audio in
    20 seconds. 100%.

    The filter chain moves here with it -- highpass and gain are SoX effects
    now -- so the encoders downstream do nothing but encode.
    """
    # MODE DOES NOT GATE THE MICROPHONE. Hide used to return an anullsrc
    # silence generator here -- "camera light off = mic off" -- which made
    # room audio unavailable exactly when someone is most likely to be
    # listening without watching. It also contradicted the writer loop, which
    # already keeps the camera open in Hide and publishes black on the grounds
    # that "Hide means do not show me the picture, not stop watching the
    # room"; two halves of one tree disagreeing about what Hide means.
    #
    # The viewer could not tell, either: the stream kept publishing, HLS went
    # green, and what it carried was digital silence at a flat -91 dB. A lamp
    # that says LIVE over silence is the failure mode this tree keeps paying
    # for, so the fix is to make it true rather than to annotate it.
    #
    # Hide still closes the CAMERA and puts its indicator light out. Only the
    # picture is withheld; the room is still audible, which is what Hide was
    # always described as meaning.
    dev = str(_cfg.get('AUDIO_DEVICE_NAME',
                       _cfg.get('AUDIO_DEVICE', 'Built-in Microphone'))).strip()
    if not dev or dev.isdigit():
        # avfoundation used an index; CoreAudio wants the name.
        dev = 'Built-in Microphone'

    # -q: SoX writes a progress meter to stderr forever otherwise, which
    # fills the capture log with megabytes of bar graphs and buries real
    # errors. -V1 keeps failures visible.
    cmd = [SOX, '-q', '-V1', '-t', 'coreaudio', dev,
           '-t', 'raw', '-b', '16', '-e', 'signed-integer',
           '-r', '48000', '-c', '1', '-']

    # Effects, in order, and deliberately few. Every element here is one more
    # thing that can put a rhythm into the sound.
    hp = str(_cfg.get('AUDIO_HIGHPASS_HZ', '')).strip()
    if hp:
        # CASCADED STAGES -- same reasoning as the ffmpeg leg above, SoX form.
        # SoX's highpass defaults to a single-pole (6 dB/oct) section, gentler
        # still than ffmpeg's, so this matters at least as much here.
        try:
            hp_stages = max(1, min(4, int(_cfg.get('AUDIO_HIGHPASS_STAGES', '1'))))
        except ValueError:
            hp_stages = 1
        cmd += ['highpass', hp] * hp_stages

    # Ceiling cut, SoX form -- same reasoning and default (14000 Hz) as the
    # ffmpeg leg above. SoX's lowpass also defaults to a single-pole
    # (6 dB/oct) section, so AUDIO_LOWPASS_STAGES matters here too.
    lp = str(_cfg.get('AUDIO_LOWPASS_HZ', '14000')).strip()
    if lp:
        try:
            lp_stages = max(1, min(4, int(_cfg.get('AUDIO_LOWPASS_STAGES', '1'))))
        except ValueError:
            lp_stages = 1
        cmd += ['lowpass', lp] * lp_stages

    # NOTCHES, for narrowband tones that are not in the room.
    #
    # A tinnitus-style tone -- one stable frequency, no bandwidth -- is the one
    # case where the dumb tool beats the clever one. A notch removes a few Hz
    # and touches nothing else; a neural denoiser decides what a sound MEANS,
    # and every speech model tried here also deleted the birds, horns and
    # slamming doors that are the point of a room monitor.
    #
    # Measured here: 3243.1 Hz, 35.6 dB above the surrounding spectrum, in
    # 0.18s bursts about every 0.68s, with an odd-harmonic signature (weak 3rd
    # at 9738 Hz, nothing at 2nd or 4th). Intermittent -- absent from both the
    # raw capture and the stream when looked for again minutes later -- which
    # is why this is configuration rather than a hardcoded filter, and why it
    # cannot be verified until the tone returns.
    #
    # AUDIO_NOTCH_HZ: comma-separated centre frequencies, e.g. "3243" or
    # "3243,8000". Width is deliberately narrow (20 Hz) so a voice crossing
    # the same pitch loses almost nothing.
    cmd += _notch_args()
    # Gain, with headroom. SoX 'gain' is a raw multiplier and will clip --
    # measured at 51k clipped samples in 20s with a bare 'gain 12', because
    # CoreAudio hands over a healthier level than ffmpeg's avfoundation did
    # and the old 12 dB was compensating for that weakness. -h reserves
    # headroom first so peaks survive instead of flattening.
    gain = str(_cfg.get('AUDIO_GAIN_DB', '')).strip()
    if gain:
        try:
            float(gain)
            cmd += ['gain', '-h', gain]
        except ValueError:
            pass
    return cmd


# Raw PCM the encoders consume: 48 kHz, mono, signed 16-bit little-endian.
_PCM_IN = ['-f', 's16le', '-ar', '48000', '-ac', '1', '-i', 'pipe:0']


def _icecast_up():
    """Is an Icecast server accepting connections on :8000?"""
    try:
        with socket.create_connection(('127.0.0.1', 8000), timeout=0.5):
            return True
    except OSError:
        return False


def _mp3_encoder_cmd():
    """LISTEN leg: PCM -> MP3 -> Icecast."""
    return [FFMPEG, '-hide_banner', '-loglevel', 'warning', *_PCM_IN,
            '-c:a', 'libmp3lame', '-b:a', '96k',
            # No bit reservoir and flush as produced: batching is latency, and
            # this is the leg someone is listening to live.
            '-reservoir', '0', '-flush_packets', '1',
            '-f', 'mp3',
            'icecast://source:roomaudio@127.0.0.1:8000/room.mp3']


def _mic_denoise_filter():
    """The optional speech denoiser, shared by every microphone encoder leg.

    It belongs on the encoders rather than the capture: it is wanted for a
    call and not for the monitor, and putting it on the shared capture would
    impose one leg's judgement on the other. Shared across legs so the room
    does not sound like a different room depending on which codec a listener
    happened to be served.
    """
    dn = str(_cfg.get('AUDIO_DENOISE', '')).strip()
    if dn:
        model = os.path.join(ROOT, 'models', f'{dn}.rnnn')
        if os.path.exists(model):
            return ['-af', f'arnndn=m={model}']
    return []


def _opus_encoder_cmd():
    """TWO-WAY leg: PCM -> Opus -> mediamtx, for WebRTC."""
    return [FFMPEG, '-hide_banner', '-loglevel', 'warning', *_PCM_IN,
            '-c:a', 'libopus', '-b:a', '96k', '-application', 'audio',
            *_mic_denoise_filter(),
            '-rtsp_transport', 'tcp', '-f', 'rtsp', ROOM_AUDIO_URL]


def _aac_encoder_cmd():
    """LISTEN leg for Apple devices: PCM -> AAC -> mediamtx, for HLS.

    Opus is not a codec Apple's HLS accepts. An iPhone served the Opus
    roomaudio playlist gets picture and silence -- the stream negotiates,
    the lamps go green, and nothing is audible, which is the exact class of
    "healthy and producing nothing" this tree keeps paying for. AAC is what
    HLS takes on that platform, so the same microphone is published a second
    time, in the one codec every HLS client can decode.

    A separate mediamtx path because one path carries one set of tracks; the
    WebRTC/two-way leg keeps Opus, which is better and which Safari handles
    perfectly well over WebRTC.
    """
    return [FFMPEG, '-hide_banner', '-loglevel', 'warning', *_PCM_IN,
            '-c:a', 'aac', '-b:a', '96k',
            *_mic_denoise_filter(),
            '-rtsp_transport', 'tcp', '-f', 'rtsp', ROOM_SOUND_URL]


def _mic_publisher_loop():
    """One capture, two encoder processes, fanned out over pipes.

    Each encoder is restarted on its own if it dies; neither can take the
    capture -- or the other -- down with it.
    """
    global _mic_proc
    while True:
        procs = {}
        try:
            with _mode_lock:
                mode = _mode
                gen = _mode_generation

            _mic_proc = subprocess.Popen(
                _mic_capture_cmd(mode),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=_open_ffmpeg_log())

            # The MP3 leg needs an Icecast server to send to. Without one it
            # dies on connect, every capture rebuild, with a BrokenPipe
            # traceback each time -- so it is started only when something is
            # listening on :8000. Listening goes over HLS (roomaudio) anyway.
            # name -> builder, so a leg that dies is rebuilt with ITS OWN
            # command. This was an inline mp3/opus conditional, which silently
            # resurrects the wrong encoder the moment a third leg exists.
            builders = {'opus': _opus_encoder_cmd,
                        'aac': _aac_encoder_cmd,
                        'mp3': _mp3_encoder_cmd}
            legs = [('opus', _opus_encoder_cmd()), ('aac', _aac_encoder_cmd())]
            if _icecast_up():
                legs.insert(0, ('mp3', _mp3_encoder_cmd()))
            for name, cmd in legs:
                pr = subprocess.Popen(
                    cmd, stdin=subprocess.PIPE,
                    stdout=subprocess.DEVNULL,
                    stderr=_open_ffmpeg_log())
                # NON-BLOCKING, and this is the whole point of the fan-out.
                #
                # A blocking write to an encoder that is busy talking to the
                # network stalls this loop, which stops draining the capture,
                # which backpressures into the microphone and starves it. That
                # is the same coupling this split was meant to remove, just
                # moved one process along: measured at 2.7s of Opus and 5.5s
                # of MP3 per 30s while the writes were blocking.
                #
                # An encoder that cannot keep up loses audio instead. Sound
                # from a device that only exists in real time is worth less
                # the later it arrives, and the capture must never pay for a
                # consumer's slowness.
                os.set_blocking(pr.stdin.fileno(), False)
                procs[name] = pr

            while True:
                buf = _mic_proc.stdout.read(_MIC_CHUNK)
                if not buf:
                    break
                for name in list(procs):
                    pr = procs[name]
                    try:
                        pr.stdin.write(buf)
                    except BlockingIOError:
                        # Its pipe is full: this encoder is behind. Drop the
                        # chunk for it alone and keep going -- the capture and
                        # the other leg must not wait.
                        continue
                    except Exception:
                        # That encoder died. Restart it alone; the capture and
                        # the other leg carry on untouched.
                        try:
                            _kill_hard(pr)
                        except Exception:
                            pass
                        cmd = builders[name]()
                        try:
                            procs[name] = subprocess.Popen(
                                cmd, stdin=subprocess.PIPE,
                                stdout=subprocess.DEVNULL,
                                stderr=_open_ffmpeg_log())
                        except Exception:
                            procs.pop(name, None)
                with _mode_lock:
                    if _mode_generation != gen:
                        break

        except Exception as exc:
            print(f'broadcast-api: mic publisher: {exc}',
                  file=sys.stderr, flush=True)
        finally:
            for pr in procs.values():
                try:
                    _kill_hard(pr)
                except Exception:
                    pass
            if _mic_proc:
                try:
                    _kill_hard(_mic_proc)
                except Exception:
                    pass
            _mic_proc = None
            # CoreAudio does not release the device instantly; reopening too
            # fast fails with an input I/O error.
            time.sleep(0.8)


def _open_ffmpeg_log():
    """Append-mode handle for ffmpeg's stderr, rotated one generation deep.

    Checked at launch rather than on a timer: a crash loop relaunches often,
    which is exactly the case that would otherwise run the disk down. Falls
    back to DEVNULL rather than taking the capture down with it -- a missing
    log is a degraded diagnosis, an exception here is a dead stream.
    """
    try:
        if os.path.exists(FFMPEG_LOG) and os.path.getsize(FFMPEG_LOG) > FFMPEG_LOG_MAX:
            os.replace(FFMPEG_LOG, FFMPEG_LOG + '.1')
        return open(FFMPEG_LOG, 'ab', buffering=0)
    except Exception:
        return subprocess.DEVNULL


def _has_rtsp_connection(pid, port):
    """True when `pid` holds an ESTABLISHED TCP socket to the local RTSP port.

    This is the signal that ffmpeg got past opening its AVFoundation input and
    actually reached mediamtx. A hung capture never opens any socket at all.
    """
    try:
        out = subprocess.run(
            [LSOF, '-a', '-p', str(pid), '-i', 'TCP', '-n', '-P'],
            capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    needle = f':{port}'
    return any('ESTABLISHED' in ln and needle in ln for ln in out.splitlines())


def _kill_hard(proc):
    """Terminate, then kill. A capture deadlocked inside avformat_open_input is
    blocked in a mach_msg syscall and will not act on SIGTERM, so don't wait on
    it politely -- give it a second, then SIGKILL.

    Written out rather than looped over (proc.terminate, proc.kill): comparing a
    bound method with `is` builds a fresh object every access and never matches,
    which silently stretched the SIGTERM grace to the SIGKILL timeout.
    """
    try:
        proc.terminate()
    except Exception:
        return
    try:
        proc.wait(timeout=1.0)
        return
    except Exception:
        pass
    try:
        proc.kill()
        proc.wait(timeout=3.0)
    except Exception:
        pass


# Startup watchdog. It measures SILENCE, not elapsed time.
#
# Asking "has it connected within N seconds?" has no right answer: 5 was too
# short for a cold AVFoundation open, so the watchdog killed the capture
# mid-open and relaunched it -- 41 consecutive failures on a 5s cadence, each
# retry interrupting a device that was still coming up. Raising N only moves
# the guess, and on OCLP Sonoma (the slow end this fleet must survive) the
# right N is not knowable in advance.
#
# Time with NO sign of life -- process alive, not connected, log not growing --
# before the capture is declared hung. This is the real watchdog: it measures
# silence, not elapsed time, so a slow device is waited out and a wedged one is
# still caught promptly.
STALL_TIMEOUT         = 12.0
# Backstop only, for a process that logs cheerfully and never connects. Should
# never be the thing that fires on healthy hardware.
CONNECT_CEILING       = 180.0
CONNECT_POLL          = 0.5
MAX_FAST_RETRIES = 3
BACKOFF_SECONDS  = 15.0


# Set once the first capture of this process actually publishes. Distinguishes
# "the device has never come up" from "the device stopped", which want very
# different patience.
_ever_connected = False


def _ffmpeg_log_size():
    """Bytes in the capture log, or -1 if it is not there yet.

    Growth is the cheapest available proof that the capture is still doing
    something. It does not matter what it wrote -- only that it wrote.
    """
    try:
        return os.path.getsize(FFMPEG_LOG)
    except OSError:
        return -1


def _writer_loop():
    """
    Combined macOS A/V publisher.

    One AVFoundation capture session owns both camera and microphone.
    There is no Python raw-video pipe, no second AVFoundation client,
    and no audio publisher competing for a second capture session.
    """
    global _cam_proc, _pub_proc

    failures = 0

    while True:
        try:
            with _mode_lock:
                spawn_mode = _mode
                spawn_gen  = _mode_generation
            # Blur is a modifier on Show (fleet convention, see Linux v6.0.5),
            # not its own feed mode -- so it rides the CV split-pipeline
            # (the only seam with a Python frame stage) while _mode stays
            # 'show'. cv_blur_post() bumps _mode_generation on toggle so
            # this reconsiders it the same way a real mode change does.
            if spawn_mode in ('cv', 'night') or (
                    spawn_mode in ('show', 'hide')
                    and (_cv_blur_mode or _detect_always_on())):
                proc = _start_cv_publisher(spawn_mode)
            else:
                proc = _start_combined_av_publisher(spawn_mode)

            # _start_cv_publisher() returns None by design when the camera leg
            # misses the first-frame gate -- it has already killed the leg and
            # cleared _cv_proc_instance, so there is nothing to adopt. The code
            # below assigned that None straight into _cam_proc/_pub_proc and
            # then called .poll() on it, which raised
            #   'NoneType' object has no attribute 'poll'
            # into the generic handler below. That handler assumes a half-built
            # pipeline and tears down, so a slow first frame turned into an
            # endless spawn/crash/teardown spin with the stream 404 the whole
            # time -- which is exactly how ariana lost video at 03:14 while the
            # camera itself was healthy (VDCAssistant logged FrameCompleted=93
            # on the very legs this was discarding). A missed gate is a retry,
            # not an exception.
            if proc is None:
                _set_capture_state('fail',
                                   'camera leg never delivered a frame; retrying')
                print('broadcast-api: capture start returned no publisher '
                      '(camera leg never delivered a frame); retrying',
                      file=sys.stderr, flush=True)
                time.sleep(2.0)
                continue

            _cam_proc = proc
            _pub_proc = proc

            # Startup race guard. ffmpeg's avfoundation input intermittently
            # deadlocks in avformat_open_input when a single session opens both
            # the camera and the microphone: the process stays alive and burns
            # CPU, but never opens its RTSP output, so mediamtx never sees a
            # publisher and viewers get a 404 off a stack that looks healthy
            # from every angle -- the pidfile is valid, and the bare wait()
            # this replaced blocked forever on a process that was never coming
            # back. So confirm the connection actually happened. Only the
            # startup window is polled; once connected we go back to a plain
            # wait() for the rest of the process's life.
            # Cold budget only while nothing has connected yet in this
            # process: once one capture has published, the device is warm and
            # a slow open really is a fault.
            ceiling   = time.monotonic() + CONNECT_CEILING
            last_sign  = time.monotonic()
            last_size  = _ffmpeg_log_size()
            connected = False
            while time.monotonic() < ceiling:
                if proc.poll() is not None:
                    break                      # died: a real failure, retry now
                if _has_rtsp_connection(proc.pid, RTSP_PORT):
                    connected = True
                    globals()['_ever_connected'] = True
                    break
                # Anything written to the capture log is a sign of life: the
                # device is being opened, negotiated, complained about. Reset
                # the patience window rather than counting down through it.
                size = _ffmpeg_log_size()
                if size != last_size:
                    last_size = size
                    last_sign = time.monotonic()
                if time.monotonic() - last_sign > STALL_TIMEOUT:
                    break                      # alive, quiet, unconnected: hung
                time.sleep(CONNECT_POLL)

            if not connected:
                failures += 1
                if proc.poll() is None:
                    print(
                        f'broadcast-api: combined AV capture (pid {proc.pid}) '
                        f'never connected to {RTSP_URL} and went quiet for '
                        f'{STALL_TIMEOUT:.0f}s -- hung opening the capture '
                        f'device; killing and relaunching '
                        f'[consecutive failures: {failures}]',
                        file=sys.stderr, flush=True,
                    )
                    _set_capture_state(
                        'fail',
                        'capture hung opening the camera/microphone'
                        + ('' if _GUI_SESSION else
                           ' -- this stack was started outside a GUI session '
                           '(launchctl managername is not Aqua), so macOS '
                           'refuses the camera and avfoundation hangs. Quit '
                           'it and launch HLS Livecam.app instead.'))
                    _kill_hard(proc)
                    _stop_cv_publisher()
                else:
                    print(
                        f'broadcast-api: combined AV capture exited '
                        f'({proc.returncode}) before connecting to {RTSP_URL} '
                        f'[consecutive failures: {failures}]',
                        file=sys.stderr, flush=True,
                    )
                    _set_capture_state(
                        'fail',
                        f'capture exited ({proc.returncode}) before connecting')

                if failures >= MAX_FAST_RETRIES:
                    print(
                        f'broadcast-api: {failures} consecutive capture '
                        f'failures; backing off {BACKOFF_SECONDS:.0f}s. '
                        f'ffmpeg stderr: {FFMPEG_LOG}',
                        file=sys.stderr, flush=True,
                    )
                    time.sleep(BACKOFF_SECONDS)
                else:
                    time.sleep(1.0)
                continue

            failures = 0
            # Connecting proves the AVFoundation session opened both the camera
            # and the microphone: ffmpeg is given -map 0:a:0, so a microphone it
            # could not open would have aborted the process rather than let it
            # reach mediamtx.
            _set_capture_state('ok', 'capture connected')
            print(
                f'broadcast-api: combined AV capture connected to {RTSP_URL} '
                f'(pid {proc.pid})',
                file=sys.stderr, flush=True,
            )

            # Poll rather than block: a plain wait() cannot notice that the
            # mode moved, and the mode is only expressible by restarting
            # ffmpeg with different inputs.
            while proc.poll() is None:
                with _mode_lock:
                    stale = (_mode_generation != spawn_gen)
                if stale:
                    print(f'broadcast-api: feed mode changed to {_mode}; '
                          f'restarting publisher', file=sys.stderr, flush=True)
                    _kill_hard(proc)
                    _stop_cv_publisher()
                    break
                time.sleep(0.25)
            rc = proc.returncode
            _stop_cv_publisher()      # no-op unless CV was the one running

            _set_capture_state('fail', f'capture exited ({rc}); restarting')
            print(
                f'broadcast-api: combined AV publisher exited ({rc}); '
                'restarting',
                file=sys.stderr,
                flush=True,
            )

            time.sleep(1.0)

        except Exception as exc:
            print(
                f'broadcast-api: combined AV publisher error: {exc}',
                file=sys.stderr,
                flush=True,
            )
            # Whatever raised may have done so after _start_cv_publisher() or
            # _start_combined_av_publisher() already spawned ffmpeg -- without
            # this, the next loop iteration calls _start_*_publisher() again,
            # which overwrites _cam_proc/_pub_proc/_cv_procs before anything
            # kills what they used to point to. That orphan keeps the camera
            # open (contending with the new capture) and outlives the app
            # indefinitely, since nothing else ever references its pid again.
            # Observed live: a leaked CV camera-leg ffmpeg, ignoring SIGTERM
            # (blocked in a mach_msg syscall, same deadlock _kill_hard's
            # docstring describes), reaped only by hand with SIGKILL.
            try:
                if _cam_proc is not None and _cam_proc.poll() is None:
                    _kill_hard(_cam_proc)
            except Exception:
                pass
            _stop_cv_publisher()
            time.sleep(2.0)


# This slot has been renamed twice now rather than deleted, so whatever
# lands next keeps the same control/endpoint/state shape: B&W Blur -> Foveal
# Layer (which shipped its checkbox permanently disabled and never wired the
# other end) -> Blur, the abandoned Cloak render, now that CV mode has a real
# frame to put it in. /api/bw-mode is not dead weight -- bin/camdash polls
# and POSTs it live (_api_get("bw-mode", ...), the [b] key), so that control
# now toggles Blur instead of nothing. /api/foveal-mode/-foveal keep working
# too; nothing currently calls them, but breaking a URL for no benefit is
# just as wrong as breaking one something depends on.
@app.route('/api/cv-blur-mode', methods=['GET'])
@app.route('/api/blur-mode', methods=['GET'])
@app.route('/api/foveal-mode', methods=['GET'])
@app.route('/api/foveal', methods=['GET'])
@app.route('/api/bw-mode', methods=['GET'])
def cv_blur_get():
    return ('true' if _cv_blur_mode else 'false'), 200


@app.route('/api/cv-blur-mode', methods=['POST'])
@app.route('/api/blur-mode', methods=['POST'])
@app.route('/api/foveal-mode', methods=['POST'])
@app.route('/api/foveal', methods=['POST'])
@app.route('/api/bw-mode', methods=['POST'])
def cv_blur_post():
    global _cv_blur_mode, _mode_generation
    with _mode_lock:
        # An explicit 'true'/'false' sets it (Tanzania's viewer); no body toggles.
        want = request.get_data(as_text=True).strip().lower()
        _cv_blur_mode = (want == 'true') if want in ('true', 'false') else not _cv_blur_mode
        _mode_generation += 1  # forces _writer_loop to restart the publisher
    return ('true' if _cv_blur_mode else 'false'), 200


# Which classes raise an alert. The detector always looks for everything it
# can name (COCO_LABELS: human, cat, dog, bird) -- narrowing THAT would mean
# rebuilding the CVProcessor on every checkbox. This gates the notifier
# instead, which re-reads the file per event, so a change takes effect with no
# restart and no gap in watching.
# What the model can name, plus two selections that are not COCO classes:
#   living  -- every animate class at once, so adding a species later does not
#              mean re-ticking a box on every node
#   motion  -- no model at all: MotionDetector turns moving regions into boxes
#              labelled 'motion'. Catches what YOLO has no word for, at the
#              cost of calling a curtain a visitor.
# The living classes the panel gives a row of their own: the ones a household
# actually expects to see.
_NAMED_LIVING = ('human', 'cat', 'dog', 'bird')

# Every OTHER animate class the model can emit. COCO's animate set is exactly
# person plus ten animals, so with these there is nothing alive left over and
# "All living beings" is finally a true statement rather than a shorthand for
# four of them.
#
# One 'other' row rather than seven, because nobody wants to tick zebra. In a
# living room every one of these is almost certainly a misclassification --
# which is the point: it is the model saying something alive is there that is
# not a person and not a pet, and that is worth a picture either way. The real
# labels survive into the HUD and the logs (see COCO_LABELS in cv_detect), so
# a spurious 'giraffe' is still diagnosable as a giraffe.
#
# NOT included: 'teddy bear', which is in COCO_LABELS as a known decoy and is
# not alive, and 'potted plant', which is alive and never going to walk in.
#
# MODEL-COUPLED, and the reason "All living beings" can be trusted. This is
# COCO-80's animate set minus the four named rows; it is complete only for
# THAT class list. A new model, a retrain, or a CV_DETECT_CLASSES change can
# add or rename animate classes, and nothing here will notice: the stored
# setting still says 'other', the panel still says "All living beings", and
# the new species is silently never alerted on.
#
# IF THE MODEL OR CLASS SET CHANGES, re-derive this from the new label map
# (COCO_LABELS in cv_detect, which carries the matching note) and check that
# _NAMED_LIVING + _OTHER_LIVING still covers every animate label it can emit.
_OTHER_LIVING = ('horse', 'sheep', 'cow', 'elephant', 'bear', 'zebra', 'giraffe')

_LIVING_CLASSES = _NAMED_LIVING + ('other',)
# 'plant' is a real detector label but NOT a living row: it is here so a
# houseplant can be named correctly and then silenced, not so it can be
# alerted on as a living being. Keeping it out of _LIVING_CLASSES is what
# stops "All living beings" from switching the false alarm back on.
_ALERT_CLASSES = (_LIVING_CLASSES + _OTHER_LIVING
                  + ('plant', 'living', 'motion'))


def _expand_classes(picked):
    """'living' stands for every animate class; keep it in the stored value so
    the choice survives a future species being added."""
    out = list(picked)
    # 'living' first: it adds 'other', which then expands below. Reversing
    # these two means ticking "All living beings" quietly leaves out every
    # animal that is not a cat, dog or bird.
    if 'living' in out:
        for c in _LIVING_CLASSES:
            if c not in out:
                out.append(c)
    if 'other' in out:
        for c in _OTHER_LIVING:
            if c not in out:
                out.append(c)
    return out


def _read_notify_classes():
    # A PRESENT-but-empty file means the operator unticked everything, and
    # that has to mean none. Treating empty as "fall back to the default" --
    # which this did -- turned "alert me about nothing" into "alert me about
    # everything", silently, which is the worst possible direction for a
    # mistake like that to go. Only a MISSING file means never configured.
    try:
        with open(NOTIFY_CLASSES_FILE) as f:
            raw = f.read()
    except Exception:
        return ['human', 'cat', 'dog']
    picked = [c.strip().lower() for c in raw.replace('\n', ',').split(',') if c.strip()]
    return _expand_classes([c for c in picked if c in _ALERT_CLASSES])


@app.route('/api/hide-stops-detection', methods=['GET'])
def hide_stops_detection_get():
    """Does Hide stop detection on THIS node? No -- not any more.

    Hide used to publish generated black from lavfi without opening the camera
    at all, which put the indicator light out but also meant nothing could be
    watched. Both cameras are in one house; Hide means "do not show me the
    picture", not "stop watching the room". It now publishes black from the
    split pipeline while the camera keeps running, matching the Linux node, so
    the answer here is false on both and the viewer's stalled-detection lamp
    never fires.
    """
    return 'false', 200


# Whether an alert carries a clip as well as the still. Read by cv_notify at
# send time, so this process only owns the switch. Defaults ON: a failed cut
# degrades to stills by itself, so the safe default is the useful one.
def _read_notify_video():
    try:
        with open(NOTIFY_VIDEO_FILE) as f:
            return f.read().strip() != 'false'
    except Exception:
        return True


# The stills switch, the same shape as the video one below it. Both can be
# off at once: the alert still arrives and says what was seen instead of
# showing it, which is a real setting for a metered connection and not a
# misconfiguration. Defaults ON, because an alert with no evidence is the
# less useful default.
def _read_notify_shots():
    try:
        with open(NOTIFY_SHOTS_FILE) as f:
            return f.read().strip() != 'false'
    except Exception:
        return True


def _read_presence_pause():
    """Withhold photos and clips while somebody is home.

    Absent means off -- the opposite default from shots/video, which are on
    unless turned off. This one withholds evidence, and a setting nobody
    chose should not quietly stop the camera recording.
    """
    try:
        with open(NOTIFY_PRESENCE_FILE) as f:
            return f.read().strip() == 'true'
    except Exception:
        return False


# THE DETECTION REGION: {"x":..,"y":..,"w":..,"h":..} as fractions of the
# frame, or absent for the whole picture. Fractions because a region stored in
# pixels means something different the day the capture resolution changes, and
# nothing would announce it.
#
# Read per frame by the writer loop and per event by the notifier, so setting
# one takes effect on the next frame rather than at the next restart.
def _read_detect_roi():
    """What the DETECTOR should use: the box only while it is switched on."""
    r = _read_detect_roi_raw()
    return r if (r and r.get('on')) else None


@app.route('/api/detect-roi', methods=['GET'])
def detect_roi_get():
    # The RAW state, so the panel can show a defined-but-off region and offer
    # to switch it back on rather than pretending nothing was ever chosen.
    r = _read_detect_roi_raw()
    return (json.dumps(r) if r else ''), 200, {'Content-Type': 'application/json'}


@app.route('/api/detect-roi', methods=['POST'])
def detect_roi_post():
    """Set the region, or clear it with an empty body -- which is the Reset.

    Clamped and validated here rather than trusted: this is the only writer,
    so a box that leaves the frame or inverts itself should never reach the
    file that the detector and the notifier both read.
    """
    raw = request.get_data(as_text=True).strip()
    try:
        os.makedirs(os.path.dirname(DETECT_ROI_FILE), exist_ok=True)
        # Empty body is Reset: forget the region entirely.
        if not raw:
            with open(DETECT_ROI_FILE, 'w') as f:
                f.write('')
            return '', 200
        d = json.loads(raw)
        toggle_only = ('x' not in d and 'on' in d)
        if not toggle_only:
            x, y = float(d['x']), float(d['y'])
            w, h = float(d['w']), float(d['h'])
    except Exception:
        abort(400)

    # OUTSIDE the try on purpose. abort() raises an HTTPException, which is an
    # Exception, so an abort inside that block would be caught by its own
    # handler and re-reported as 400 -- an intentional signal swallowed by a
    # broad except and turned into the wrong answer. It returned 400 for
    # "there is no region to switch on", which reads as "your request was
    # malformed" and sends the reader to inspect a request that was fine.
    if toggle_only:
        cur = _read_detect_roi_raw()
        if not cur:
            abort(409)          # nothing to switch on
        cur['on'] = bool(d['on'])
        try:
            with open(DETECT_ROI_FILE, 'w') as f:
                f.write(json.dumps(cur))
        except Exception:
            abort(500)
        return json.dumps(cur), 200, {'Content-Type': 'application/json'}
    x = min(max(x, 0.0), 1.0)
    y = min(max(y, 0.0), 1.0)
    w = min(max(w, 0.0), 1.0 - x)
    h = min(max(h, 0.0), 1.0 - y)
    # A region smaller than this is almost certainly a stray click rather than
    # an intention, and one that small would starve the detector of context.
    if w < 0.05 or h < 0.05:
        abort(400)
    # Drawing a region turns it on: nobody draws a box in order to not use it.
    box = {'x': round(x, 5), 'y': round(y, 5), 'w': round(w, 5), 'h': round(h, 5),
           'on': bool(d.get('on', True))}
    try:
        with open(DETECT_ROI_FILE, 'w') as f:
            f.write(json.dumps(box))
    except Exception:
        abort(500)
    return json.dumps(box), 200, {'Content-Type': 'application/json'}


