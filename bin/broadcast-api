#!/usr/bin/env python3
"""
broadcast-api -- hls-livecam-server (macOS port)

Studio pipeline + message/dark/buzz endpoints + static web serving.

macOS differences from the Linux original:
  * Camera captured via ffmpeg's avfoundation input, not v4l2.
  * No v4l2loopback / pyfakewebcam. Processed RGB frames are written
    straight into a publisher ffmpeg's stdin (rawvideo pipe), which
    pushes RTSP to mediamtx. No kernel module required.
  * This process also serves the web viewer, /api/*, and the state
    files (broadcast.txt, buzz.txt, dark.png, cams.json) — replacing
    nginx. Everything is on WEB_PORT; no root, no port-80 conflict.
"""
import json, os, subprocess, time, sys, threading, io, signal, socket, re, shutil, select, queue, collections
import numpy as np
from PIL import Image
from flask import Flask, request, abort, send_from_directory, Response, redirect

# ── Paths (repo-relative, no FHS) ────────────────────────────────
BIN_DIR   = os.path.dirname(os.path.abspath(__file__))
ROOT      = os.path.dirname(BIN_DIR)
WEB_DIR   = os.path.join(ROOT, "web")
STATE_DIR = os.path.join(ROOT, "state")
CONFIG    = os.path.join(ROOT, "config.env")
os.makedirs(STATE_DIR, exist_ok=True)

# Capture ffmpeg's stderr to a real file. It used to go to DEVNULL, which is
# why a capture wedged inside avformat_open_input left no trace anywhere: the
# process stayed alive, the pidfile stayed valid, and every viewer got a 404
# off a stack that looked healthy (observed: 31 minutes, silently).
# When installed, ROOT is inside the read-only .app bundle -- the state dir
# humans actually read (and the one livecam writes broadcast-api.log and
# mediamtx.log into) lives in Application Support. Follow it there.
_IN_BUNDLE = ".app/Contents/Resources/" in BIN_DIR
