MAX_LEN        = 120
GOL_COLS       = 80

# run-13: never invoke ffmpeg by bare name. Under the launchd agent the PATH is
# the launchd default (/usr/bin:/bin:/usr/sbin:/sbin) -- it does NOT include
# /usr/local/bin, where Homebrew's ffmpeg lives. A bare 'ffmpeg' therefore
# raises FileNotFoundError inside the writer thread the moment the pipeline is
# started by the login agent rather than by hand, killing capture outright while
# the Flask side keeps serving happily (observed in broadcast-api.log). Resolve
# once, at import, against PATH and then the known install locations.
# Camera helper inside the installed macOS application bundle.
_CAMERA_HELPER = os.path.normpath(os.path.join(
    os.path.dirname(__file__),
    "..",
    "Helpers",
    "HLS Livecam Camera.app",
    "Contents",
    "MacOS",
    "camera-capture",
))

FFMPEG = (
    shutil.which('ffmpeg')
    or next((p for p in ('/usr/local/bin/ffmpeg',
                         '/opt/homebrew/bin/ffmpeg',
                         '/usr/bin/ffmpeg')
             if os.path.exists(p)), None)
    or 'ffmpeg'
)

# Same PATH hazard as ffmpeg above: under launchd, /usr/sbin is on the default
# PATH, but resolve explicitly rather than betting the watchdog on it.
LSOF = shutil.which('lsof') or '/usr/sbin/lsof'

app = Flask(__name__)


# SoX, for microphone capture. See _mic_capture_cmd for why the capture is
# not ffmpeg: its avfoundation audio input drops most of the stream on macOS.
SOX = (
    shutil.which('sox')
    or next((q for q in ('/usr/local/bin/sox', '/opt/homebrew/bin/sox')
             if os.path.exists(q)), 'sox')
)


def _read_config():
    env = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    k, v = line.split('=', 1)
                    # Values are read to EOL, but tolerate an inline "# comment".
                    if '#' in v and k.strip() != 'AVF_DEVICE_NAME':
                        v = v.split('#', 1)[0]
                    env[k.strip()] = v.strip()
    except Exception:
        pass
    return env


_cfg      = _read_config()
# The Settings panel's audio values (/api/audio-settings) live in their own
# untracked file layered over config.env, so tuning from the page never
# dirties the tracked config (the build refuses a dirty tree).
AUDIO_SETTINGS = os.path.join(STATE_DIR, 'audio-settings.json')


def _load_audio_settings():
    try:
        with open(AUDIO_SETTINGS) as f:
            return {k: str(v) for k, v in json.load(f).items()}
    except Exception:
        return {}


_cfg.update(_load_audio_settings())
FRAME_W, FRAME_H = (int(x) for x in _cfg.get('VIDEO_SIZE', '1280x720').split('x'))
FRAME_BYTES = FRAME_W * FRAME_H * 3
RTSP_PORT   = _cfg.get('RTSP_PORT', '8554')
RTSP_URL    = f"rtsp://127.0.0.1:{RTSP_PORT}/cam"
HLS_PORT    = _cfg.get('HLS_PORT', '8888')

# Blur renderer: 'font' (original, PIL text engine) or 'vector' (run-7 §3).
# Defaults to 'font' so behaviour is unchanged until the PM gates the vectorized
# look -- it drops glyph antialiasing, which is an aesthetic call, not a bug fix.
BLUR_RENDERER = _cfg.get('BLUR_RENDERER', 'vec').strip().lower()

# Keyframe interval in seconds. Must match mediamtx's hlsSegmentDuration.
GOP_SECONDS = float(_cfg.get('GOP_SECONDS', 1))

_cam_proc = None
_pub_proc = None

# ── Pipeline status ──────────────────────────────────────────────
#
# The viewer's audio panel shows a lamp per stage. Three of them sat grey
# forever because nothing server-side ever reported on them, and a permanently
# grey lamp is indistinguishable from a broken one.
#
# The capture stage is reported by the writer loop, which is the only thing
# that knows whether ffmpeg got past opening the devices. It is deliberately
# not inferred from "is the process alive": a capture deadlocked inside
# avformat_open_input is alive, burning CPU, and producing nothing, which is
# the exact failure this stack was losing hours to.
_pipeline_lock  = threading.Lock()
_pipeline_state = {'capture': 'pending', 'detail': 'starting'}


def _gui_session():
    """True when this process is in an Aqua (GUI) session.

    macOS grants camera access on the responsible process's session, and
    avfoundation DEADLOCKS rather than erroring when refused -- so a stack
    started from a shell or over SSH hangs with no message at all. Naming the
    cause turns a silent hang into a sentence.
    """
    try:
        out = subprocess.run(['launchctl', 'managername'],
                             capture_output=True, text=True, timeout=5).stdout
        return out.strip() == 'Aqua'
    except Exception:
        return True          # cannot tell; do not cry wolf


_GUI_SESSION = _gui_session()


def _set_capture_state(state, detail=''):
    with _pipeline_lock:
        _pipeline_state['capture'] = state
        _pipeline_state['detail']  = detail

# ── Mode state ───────────────────────────────────────────────────
#
# Persisted, and defaulting to hidden when absent. The mode used to live only
# in memory, so any restart -- a crash, a reboot, an update -- silently
# reopened the camera. A privacy control that quietly resets itself is the
# same failure as one that never worked; the whole point of Hide is that it
# stays hidden until someone says otherwise.
#
# Fail closed: an unreadable or missing file means hidden, never showing.
MODE_FILE = os.path.join(STATE_DIR, "feed_mode")


def _read_mode():
    try:
        with open(MODE_FILE) as f:
            v = f.read().strip()
        return v if v in ('show', 'cv', 'hide', 'night') else 'hide'
    except Exception:
        return 'hide'


def _write_mode(value):
    # Same temp+fsync+replace as the enabled flag: a power cut mid-write must
    # not leave a truncated file, which would read back as hidden anyway --
    # but deliberately, not by luck.
    try:
        tmp = MODE_FILE + ".tmp"
        with open(tmp, "w") as f:
            f.write(value + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, MODE_FILE)
    except Exception as exc:
        print(f'broadcast-api: could not persist feed mode: {exc}',
              file=sys.stderr, flush=True)


_mode      = _read_mode()
_mode_lock = threading.Lock()
# Bumped on every mode change. The writer loop captures it when it spawns a
# publisher and tears that publisher down as soon as the value moves, which is
# how a mode change reaches the encoder at all -- the mode decides which
# devices ffmpeg opens, so it cannot be applied to a running process.
_mode_generation = 0


# -- Detection independent of what the feed is showing --
#
# Detection only ever ran where frames passed through Python, and in Show they
# do not: _start_combined_av_publisher sends camera -> RTSP in one ffmpeg with
# no frame stage at all. So alerting was a side effect of a VIEWING choice --
# and the notifier exists precisely for when nobody is viewing.
#
# With this on, Show spawns the split pipeline too, but renders NOTHING: frames
# are written through byte-for-byte and the detector is fed off the same
# pre-render tap process() would have used. The picture a viewer gets is the
# same plain camera as before; the difference is that the room is now watched.
def _read_detect_always():
    try:
        with open(DETECT_ALWAYS_FILE) as f:
            return f.read().strip() != 'false'
    except Exception:
        return True

def _write_detect_always(enabled):
    """Raises on failure.

    This used to swallow. That shape is how notify_shots on the other
    lineage went releases persisting nothing while the panel showed the
    lamp move -- a permission error turned into a successful-looking
    click by `except: pass`. The caller turns this into a 500.
    """
    os.makedirs(os.path.dirname(DETECT_ALWAYS_FILE), exist_ok=True)
    with open(DETECT_ALWAYS_FILE, 'w') as f:
        f.write('true' if enabled else 'false')


# Module-level, and NOT optional: detect_always_get() reads this global
# directly rather than the file. A rewrite of the writer above deleted this
# line and every GET became a 500 -- the POST still worked, because it
# assigns the global on the way through, so the setting looked healthy from
# the one direction nobody tests first.
_detect_always = _read_detect_always()

def _detect_always_on():
    return _detect_always
# Blur: a modifier on CV mode, reusing the old Cloak mode's block-art render
