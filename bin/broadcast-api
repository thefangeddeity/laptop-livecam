_pipeline_cache = {'at': 0.0, 'data': None}
_PIPELINE_TTL   = 2.0


def _tcp_open(port, timeout=0.5):
    try:
        with socket.create_connection(('127.0.0.1', int(port)), timeout=timeout):
            return True
    except Exception:
        return False


@app.route('/hls/<path:subpath>')
def hls_proxy(subpath):
    """Serve mediamtx's HLS under this origin.

    The viewer asks for `window.location.origin + '/hls/cam/index.m3u8'`, which
    on the Linux node nginx proxies to mediamtx. ariana has no nginx, and had no
    equivalent route, so every browser hitting this node's viewer got a 404 for
    the stream while mediamtx was serving it perfectly on :8888. Same origin
    matters beyond tidiness: it keeps the player clear of CORS, and it is what
    lets the page work over whatever host the phone used to reach it.

    Streamed, not buffered: a segment is megabytes and must not be read into
    memory before the first byte reaches the player.
    """
    import urllib.request as _u
    import urllib.error as _ue
    url = f'http://127.0.0.1:{HLS_PORT}/{subpath}'
    try:
        up = _u.urlopen(url, timeout=10)
    except _ue.HTTPError as exc:
        return ('', exc.code)
    except Exception:
        return ('', 502)

    ctype = up.headers.get('Content-Type', 'application/octet-stream')

    def _pump():
        try:
            while True:
                chunk = up.read(65536)
                if not chunk:
                    break
                yield chunk
        finally:
            try:
                up.close()
            except Exception:
                pass

    resp = Response(_pump(), content_type=ctype)
    # A live playlist that gets cached is a stream that stops advancing.
    resp.headers['Cache-Control'] = 'no-store'
    resp.headers['Access-Control-Allow-Origin'] = '*'
    return resp


def _hls_audio_state():
    """('ok'|'fail', has_audio_track) for the local HLS master playlist."""
    try:
        import urllib.request
        url = f'http://127.0.0.1:{HLS_PORT}/cam/index.m3u8'
        with urllib.request.urlopen(url, timeout=1.5) as r:
            if r.status != 200:
                return 'fail', False
            body = r.read(8192).decode('utf-8', 'replace')
        return 'ok', ('TYPE=AUDIO' in body)
    except Exception:
        return 'fail', False


@app.route('/stream.mp3')
def stream_mp3():
    """The room, as progressive MP3. Same origin, so no mixed-content rule and
    no proxy path prefix to lose a redirect in."""
    q = _mic_hub.subscribe()

    def gen():
        try:
            while True:
                yield q.get()
        finally:
            _mic_hub.unsubscribe(q)

    resp = Response(gen(), mimetype='audio/mpeg',
                    direct_passthrough=True)
    # No Content-Length and no range support: this is a live stream, not a
    # file, and advertising seekability invites range requests that cannot be
    # satisfied.
    resp.headers['Cache-Control'] = 'no-store, no-cache'
    resp.headers['Connection'] = 'close'
    return resp



# -- CV CAPABILITY -----------------------------------------------------------
# Whether THIS machine can render CV mode without falling behind the camera.
#
# MEASURED, not inferred. Core count and CPU model are proxies that go stale
# with every new chip and lie on a throttled or shared box; the only honest
# answer is to run the work and time it. The probe renders a synthetic frame
# through the real CVProcessor, so it prices exactly what CV costs here.
#
# Three states, deliberately. 'weak' hides the CV key; 'unknown' does NOT --
# a probe that failed to run is not evidence a machine is slow, and a control
# that vanishes because a measurement errored is worse than one that stays
# and performs badly.
_cv_cap_cache = None
_cv_cap_lock = threading.Lock()


# ── OBSERVED CV COST ────────────────────────────────────────────────
# The verdict comes from frames this node ACTUALLY rendered, not from a
# nameplate and not from a synthetic probe.
#
# Both of those were tried and both were wrong in the same direction. The
# synthetic probe measures a cheaper-than-real frame on a quiet machine at
# startup, reads low, and flaps between restarts. A CPU-model whitelist
# cannot see a throttled laptop, a busy node or a GPU, has to be rewritten
# for every new part, and silently mislabels anything it has not heard of.
#
# What is left is the only honest question -- did THIS machine keep up? --
# and it has an exact answer once CV has run. Until then the verdict is
# `unknown`, which KEEPS the control: hiding a working feature on a guess is
# worse than showing one that may be slow.
_CV_OBS_MAX     = 240    # rolling window of per-frame render times (ms)
_CV_OBS_MIN     = 90     # before this many, we have not seen enough to judge
_cv_obs         = collections.deque(maxlen=_CV_OBS_MAX)
_cv_obs_lock    = threading.Lock()
_CV_VERDICT_F   = os.path.join(STATE_DIR, 'cv_verdict.json')


def _cv_obs_record(ms):
    """One rendered frame's cost. Called from the CV loop; must stay cheap."""
    with _cv_obs_lock:
        _cv_obs.append(ms)
        n = len(_cv_obs)
    if n == _CV_OBS_MIN or (n == _CV_OBS_MAX and n % _CV_OBS_MAX == 0):
        _cv_verdict_save()


def _cv_obs_median():
    with _cv_obs_lock:
        if not _cv_obs:
            return None, 0
        xs = sorted(_cv_obs)
        return xs[len(xs) // 2], len(xs)


def _cv_budget_ms():
    return 1000.0 / max(1, int(_cfg.get('FRAMERATE', 15)))


def _cv_verdict_save():
    """Remember the verdict so a restart does not start guessing again."""
    med, n = _cv_obs_median()
    if med is None or n < _CV_OBS_MIN:
        return
    try:
        with open(_CV_VERDICT_F, 'w') as fh:
            json.dump({'cpu': _cpu_brand(), 'median_ms': round(med, 1),
                       'samples': n, 'budget_ms': round(_cv_budget_ms(), 1),
                       'at': time.time()}, fh)
    except Exception:
        pass                       # a lost verdict costs a re-measure, nothing


def _cv_verdict_load():
    """The remembered verdict, only if it was measured on THIS hardware."""
    try:
        with open(_CV_VERDICT_F) as fh:
            v = json.load(fh)
        if v.get('cpu') and v['cpu'] != _cpu_brand():
            return None            # the disk moved to another machine
        return v
    except Exception:
        return None


def _cpu_brand():
    """The CPU's own name, or '' if the platform will not say."""
    try:
        if sys.platform == 'darwin':
            return subprocess.run(['sysctl', '-n', 'machdep.cpu.brand_string'],
                                  capture_output=True, text=True, timeout=3).stdout.strip()
        with open('/proc/cpuinfo') as fh:
            for line in fh:
                if line.lower().startswith('model name'):
                    return line.split(':', 1)[1].strip()
    except Exception:
        pass
    return ''


def _cpu_tier(brand):
    """'ok' | 'unfit' | 'unknown' from a CPU brand string.

    The line is a hardware class, not a stopwatch: anything below an i5
    loses the CV key. A timing probe alone put a working machine on the
    wrong side -- it measures a quiet node at startup and a synthetic frame
    that is cheaper than a real one, so it reads low exactly where it
    matters and flaps between restarts.

    A whitelist of classes at least i5-equivalent, a blacklist of classes
    below it, and 'unknown' for everything else -- which KEEPS the key.
    Hiding a working control on a guess is the worse failure: the cost of
    showing it on a slow machine is some CPU, the cost of hiding it on a
    capable one is a feature that silently does not exist.
    """
    b = (brand or '').lower()
    if not b:
        return 'unknown'
    if re.search(r'\bapple m\d', b):          # every shipped M-series clears it
        return 'ok'
    # NOTE the trademark mark: the real string is "Core(TM)2 Duo", so the 2
    # binds to "(tm)" and a plain \bcore\s*2 never matches it.
    _tm = r'core(?:\(tm\))?'
    if (re.search(_tm + r'\s*2\b', b)
            or re.search(_tm + r'\s*(duo|solo)\b', b)
            or re.search(r'\b(celeron|pentium|atom|sempron|turion)\b', b)):
        return 'unfit'
    m = re.search(_tm + r'[\s._-]*i([3579])\b', b) or re.search(r'\bi([3579])-\d', b)
    if m:
        return 'ok' if int(m.group(1)) >= 5 else 'unfit'
    m = re.search(r'\bryzen\s+(\d)\b', b)     # Ryzen 3 sits with i3
    if m:
        return 'ok' if int(m.group(1)) >= 5 else 'unfit'
    if re.search(r'\b(xeon|epyc|threadripper|ultra\s*\d)\b', b):
        return 'ok'
    return 'unknown'


def _cv_capability():
    """{'state','process_ms','observe_ms','budget_ms','reason'} -- cached.

    Hardware does not change under a running process, so this is probed once
    and reused; lazily, because most starts never ask.
    """
    global _cv_cap_cache
    with _cv_cap_lock:
        # The synthetic part is hardware and never changes, but the VERDICT
        # does: a node boots `unknown` and earns a real answer once CV has
        # run. Caching that first answer forever would mean the measurement
        # never takes effect, so a cached `unknown` is re-derived.
        if _cv_cap_cache is not None and _cv_cap_cache.get('state') != 'unknown':
            return _cv_cap_cache
        _med_now, _n_now = _cv_obs_median()
        if _cv_cap_cache is not None and _n_now < _CV_OBS_MIN and not _cv_verdict_load():
            return _cv_cap_cache
        out = {'state': 'unknown', 'process_ms': None, 'observe_ms': None,
               'budget_ms': None, 'reason': 'not probed'}
        try:
            import numpy as _np
            import cv2 as _cv2
            import cv_processor as _cvp_probe
            fr = max(1, int(_cfg.get('FRAMERATE', 15)))
            budget = 1000.0 / fr
            # A ROOM, not noise. Uniform random pixels are the CHEAPEST input
            # this pipeline sees, not the worst: measured here, noise ran
            # 50.6ms while a real camera frame took 66.2ms, so probing with
            # noise understated true cost by roughly a third and would have
            # called a machine capable that cannot actually keep up.
            # Gradient + flat blocks + a little grain, measured with a fresh
            # processor each time (state carried between runs makes these
            # numbers lie): noise 48.6ms, this frame 58.0ms, a real camera
            # frame 70.6ms. So this still UNDERSTATES a real scene by roughly
            # a fifth -- it is a floor, not a forecast. That is what the 70
            # percent budget threshold below is absorbing, and it is why the
            # threshold is not 100. A synthetic frame is used at all because
            # the camera may not be open when the probe runs.
            _yy, _xx = _np.mgrid[0:FRAME_H, 0:FRAME_W]
            _g = ((_xx / float(FRAME_W) * 140) + (_yy / float(FRAME_H) * 90) + 20).astype(_np.uint8)
            frame = _cv2.merge([_g, _g, _g])
            for _i in range(6):
                _cv2.rectangle(frame, (80 + _i * 160, 60 + _i * 70),
                               (240 + _i * 160, 300 + _i * 70),
                               (40 + _i * 25, 90, 160 - _i * 18), -1)
            _cv2.circle(frame, (FRAME_W // 2, FRAME_H // 2), 110, (200, 190, 170), -1)
            frame = _cv2.add(frame, (_np.random.rand(FRAME_H, FRAME_W, 3) * 12).astype(_np.uint8))
            proc = _cvp_probe.CVProcessor(dict(_cfg))

            def _med(fn, n=15):
                fn(frame.copy())                 # warm: first call pays setup
                ts = []
                for _ in range(n):
                    f = frame.copy()
                    t0 = time.perf_counter()
                    fn(f)
                    ts.append((time.perf_counter() - t0) * 1000.0)
                ts.sort()
                return ts[len(ts) // 2]

            obs = _med(proc.observe)
            ren = _med(proc.process)
            # 60% of the frame budget, and the margin is doing real work.
            # This probe is a FLOOR, biased low twice over:
            #   * a synthetic frame is cheaper than a real one (58ms vs 71ms
            #     measured here, with a fresh processor each time), and
            #   * it runs at startup, before capture and the detection
            #     threads are loaded, so it sees a quieter machine than the
            #     one that will actually render. Measured in-process it read
            #     44-50ms where a steady-state run of the same work took
            #     53.5-62.9ms.
            # At 70% those two biases put this node on the wrong side of the
            # line AND made the verdict flap between restarts, which would
            # have shown as the CV key appearing and vanishing. 60% puts both
            # nodes clearly on their correct side with room to spare.
            # TWO states, because only one distinction changes anything:
            # can this machine draw a frame inside the frame interval, or
            # not. A node that renders in 50ms against a 67ms budget does
            # the work -- calling it `weak` labelled half the fleet for a
            # margin nobody acts on. The old 60%-of-budget line existed to
            # stop a verdict flapping between restarts; a number in the
            # payload serves that better than an adjective in the UI, so
            # `headroom` carries it and nothing branches on it.
            #   ok     <= 100% of budget  -- renders in time
            #   unfit   > 100% of budget  -- cannot; CV would eat the stream
            # The reference node measures 32ms against 67ms, the mac 50ms:
            # both render, both keep the key. Only a machine that misses the
            # interval outright loses it, and that line is arithmetic rather
            # than taste.
            # The synthetic numbers stay, as numbers. They do NOT decide:
            # this frame is cheaper than a real one and the machine is
            # quieter at startup than it will ever be again, so letting it
            # rule would put a working node on the wrong side of the line --
            # which is exactly what it did.
            _brand = _cpu_brand()
            _med, _n = _cv_obs_median()
            _rem = _cv_verdict_load()
            if _med is not None and _n >= _CV_OBS_MIN:
                _state = 'unfit' if _med > budget else 'ok'
                _why = ('%.0fms median over %d rendered frames vs %.0fms budget'
                        % (_med, _n, budget))
                _src = 'measured'
            elif _rem and _rem.get('median_ms') is not None:
                _state = 'unfit' if _rem['median_ms'] > budget else 'ok'
                _why = ('%.0fms median measured earlier on this machine vs '
                        '%.0fms budget' % (_rem['median_ms'], budget))
                _src = 'remembered'
            else:
                # Never yet rendered here. Say so, and KEEP the control.
                _state = 'unknown'
                _why = ('not yet measured on real frames (probe: %.0fms vs '
                        '%.0fms budget)' % (ren, budget))
                _src = 'unmeasured'
            out = {'state': _state,
                   'source': _src,
                   'cpu': _brand,
                   'probe_ms': round(ren, 1),
                   'observed_ms': round(_med, 1) if _med is not None else None,
                   'observed_n': _n,
                   'headroom': round(1.0 - (ren / budget), 2),
                   'process_ms': round(ren, 1), 'observe_ms': round(obs, 1),
                   'budget_ms': round(budget, 1),
                   'reason': _why}
        except Exception as exc:
            out['reason'] = 'probe failed: %s' % exc
        _cv_cap_cache = out
        return out


@app.route('/api/pipeline', methods=['GET'])
def pipeline():
    """Per-stage health for the viewer's audio panel.

    Every value here is measured, never assumed. The panel previously lit only
    the HLS lamp because that was the one stage a browser can observe for
    itself; the other three are server-side facts that had no way to reach it.

    Polled by every open viewer, so results are cached briefly -- the lsof and
    socket probes are cheap but not free, and the underlying state does not
    change faster than the cache window.
    """
    now = time.time()
    if _pipeline_cache['data'] and now - _pipeline_cache['at'] < _PIPELINE_TTL:
        return _pipeline_cache['data']

    with _pipeline_lock:
        capture = _pipeline_state['capture']
        detail  = _pipeline_state['detail']

    mediamtx = 'ok' if _tcp_open(RTSP_PORT) else 'fail'

    # RTSP is the publisher's own socket to mediamtx, which is a stronger claim
    # than "the port is listening": it says this capture reached it.
    #
    # Order matters. Testing the process first reports a red lamp during the
    # ordinary startup window, before the writer loop has spawned ffmpeg at
    # all -- a failure indication for a stack that is merely still starting.
    # Defer to the capture stage, which is the thing that knows.
    proc = _pub_proc
    if capture == 'pending':
        rtsp = 'pending'
    elif proc is None or proc.poll() is not None:
        rtsp = 'fail'
    else:
        rtsp = 'ok' if _has_rtsp_connection(proc.pid, RTSP_PORT) else 'fail'

    hls, has_audio = _hls_audio_state()

    # Encoder settings, reported rather than measured. These are what ffmpeg
    # was told to produce, so they are exact for as long as capture is up; the
    # alternative -- deriving them from the manifest -- only offers a combined
    # video+audio BANDWIDTH, which would overstate the audio figure badly.
    # Reported as null when capture is not connected, so the viewer shows
    # unlit segments instead of describing a stream that is not running.
    try:
        audio_rate = int(str(_cfg.get('AUDIO_RATE', '48000')).strip())
    except ValueError:
        audio_rate = None
    # MONO, and not from config: the room microphone is a single capsule and
    # the publisher folds it to one channel on purpose (a stereo frame spent
    # half its bits describing a duplicate). Reporting the configured value
    # here would have the panel claim STEREO over a mono stream, which is the
    # sort of small lie that costs an hour later.
    audio_ch = 1
    try:
        audio_kbps = int(str(_cfg.get('AUDIO_BITRATE_K', '96')).strip())
    except ValueError:
        audio_kbps = None
    if capture != 'ok':
        audio_rate = audio_ch = audio_kbps = None

    # Hide withholds the PICTURE. Whether it also closes the DEVICES depends
    # on which publisher is running, so neither lamp is inferred from the mode
    # any more -- both are read from the process that would be holding the
    # hardware. See below; `capture` here stays as the *publisher* stage.
    #
    # This used to force capture='off' and report 'camera closed' whenever the
    # mode was hide. On the CV path that is simply false: the writer loop
    # keeps avfoundation open and publishes a black frame, precisely so the
    # detector goes on watching the room. Measured in Hide: `-i 0:none` live,
    # feeding the frame pipeline, FPS graphing, DET lit -- while the panel
    # said the camera was closed and the Mac's camera LED was on.
    #
    # A privacy indicator that under-reports live capture is the worst
    # direction for one to be wrong in, and this one was also contradicting
    # hardware the operator can see.
    with _mode_lock:
        mode_now = _mode
    if mode_now == 'hide':
        capture = 'off'
        detail = 'feed hidden; publishing black'
        # Audio figures are NOT cleared here any more. They were, on the
        # premise that "nothing from the room is being encoded" -- no longer
        # true. Blanking RATE/BITS while the room is audible tells the panel
        # a quieter version of the same lie the mic lamp was telling.

    # Faculty lamps, read from the live CVProcessor instance rather than
    # asserted from config -- a stalled pipeline puts these out by itself
    # rather than leaving them lit over a frozen frame. None (not False)
    # when CV isn't running at all: unknown must look different from
    # measured-and-off. 3D has no reading at all, ever -- depth is not
    # implemented on this branch, same as tina's own 3D socket; the day it
    # lands, this gets a real value instead of the control quietly
    # disappearing and reappearing.
    cvp = _cv_proc_instance
    if cvp is not None and mode_now == 'cv':
        mog2 = getattr(cvp, '_fg_mask', None) is not None
        foveal = bool(getattr(cvp, '_foveal_enabled', False)) and mog2
        scene = 'registered' if getattr(cvp, '_scene_registered', False) else 'none'
        # Same words as the burned-in banner/capability lines (ported from
        # tanzania: see cv_processor._detect_and_hud / cv_detect.
        # hud_banner_text) -- one source, so a client-side HUD can show
        # this and it can never drift from what's on the picture.
        cv_text = getattr(cvp, '_hud_text', '')
        cv_capability_text = getattr(cvp, '_hud_capability_text', '')
    else:
        mog2 = foveal = None
        scene = None
        cv_text = cv_capability_text = None

    # The mic is its OWN process now (SoX via CoreAudio), not a mapped output
    # of the camera's AVFoundation session, so its lamp reads that process
    # rather than the camera's state. poll() rather than "is the object
    # there": a dead child still answers to pid_exists and friends.
    _mp = _mic_proc
    mic_state = 'ok' if (_mp is not None and _mp.poll() is None) else 'down'

    # Same treatment for the camera: read the process that holds the device,
    # not the mode. poll() rather than "is the object there" -- a dead child
    # still answers to pid_exists and friends.
    _cp = _cam_proc
    cam_live = _cp is not None and getattr(_cp, 'poll', lambda: 0)() is None
    camera_state = 'ok' if cam_live else capture
    if mode_now == 'hide' and cam_live:
        detail = 'feed hidden; publishing black -- camera and microphone OPEN'

    _cap = _cv_capability()
    data = {
        'cv_capable':    _cap['state'],
        'cv_capability': _cap,
        'mode':     mode_now,
        'cv':       mode_now == 'cv',
        'cv_mog2':  mog2,
        'cv_foveal': foveal,
        'cv_scene': scene,
        'cv_text': cv_text,
        'cv_capability_text': cv_capability_text,
        'mic':      mic_state,
        'camera':   camera_state,
        'audio_rate_hz':  audio_rate,
        'audio_channels': audio_ch,
        'audio_kbps':     audio_kbps,
        # What the LISTEN path actually is, so the panel can say so rather
        # than inferring it from which lamp happens to be lit.
        'audio_codec':    None if audio_kbps is None else 'mp3',
        'audio_listen':   None if audio_kbps is None else 'icecast',
        'mediamtx': mediamtx,
        'rtsp':     rtsp,
        'hls':      hls,
        'audio_track': has_audio,
        'detail':   detail,
    }
    _pipeline_cache['at']   = now
    _pipeline_cache['data'] = data
    return data


@app.route('/api/info', methods=['GET'])
def info():
    hostname = socket.gethostname()
    tailscale = ''
    try:
        # macOS: tailscale IPs live on a utun interface; ifconfig lists them.
        out = subprocess.run(['ifconfig'], capture_output=True, text=True).stdout
        m = re.search(r'inet (100\.\d+\.\d+\.\d+)', out)
        if m:
            tailscale = m.group(1)
    except Exception:
        pass
    # The viewer sizes its message box from this and clamps its own input to
    # it. Serving the limit rather than duplicating 120 in the page keeps one
    # definition: the box cannot end up sized for a length the server will
    # then truncate.
    # Product identity is served, not spelled out in the viewer. The fleet is
    # two products now -- HLS Livecam and HLS LightCV -- and which one a node
    # runs is a property of the node, not of the page. amira is a Mac running
    # LightCV, so platform cannot stand in for it either. Same reasoning as
    # the version: a constant in the viewer is a second place to forget.
    return {
        'hostname':      hostname,
        'tailscale':     tailscale,
        'msg_max_len':   MAX_LEN,
        'product':       _cfg.get('PRODUCT_NAME',   'HLS Livecam'),
        'product_short': _cfg.get('PRODUCT_SHORT',  'HLSLS'),
    }


@app.route('/api/reset', methods=['POST'])
def api_reset():
    # Full reset: relaunch the whole stack the way `livecam restart` does, from a
    # DETACHED child that outlives this (soon-restarted) worker. It waits ~1s so
    # the 202 reaches the browser, then execs the restart.
    livecam = os.path.join(BIN_DIR, 'livecam')
    try:
        subprocess.Popen(
            ['/bin/sh', '-c',
             'sleep 1; PATH=/usr/local/bin:$PATH exec "$0" restart', livecam],
            start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            cwd=ROOT,
        )
    except Exception as e:
        return {'ok': False, 'error': str(e)}, 500
    return {'ok': True, 'restarting': True}, 202


# ── Static web serving (replaces nginx) ──────────────────────────
_NO_CACHE = {
    'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0',
    'Pragma': 'no-cache',
    'Access-Control-Allow-Origin': '*',
}


def _nocache(resp):
    for k, v in _NO_CACHE.items():
        resp.headers[k] = v
    return resp


@app.route('/broadcast.txt')
def serve_broadcast():
    try:
        with open(BROADCAST_FILE) as f:
            body = f.read()
    except FileNotFoundError:
        body = ''
    return _nocache(Response(body, mimetype='text/plain'))


@app.route('/buzz.txt')
def serve_buzz():
    try:
        with open(BUZZ_FILE) as f:
            body = f.read()
    except FileNotFoundError:
        body = ''
    return _nocache(Response(body, mimetype='text/plain'))


@app.route('/dark.png')
def serve_darkpng():
    path = os.path.join(STATE_DIR, 'dark.png')
    if not os.path.exists(path):
        abort(404)
    return _nocache(send_from_directory(STATE_DIR, 'dark.png'))


@app.route('/cams/cams.json')
def serve_cams_json():
    return _nocache(send_from_directory(os.path.join(WEB_DIR, 'cams'), 'cams.json',
                                        mimetype='application/json'))


# -- Tanzania's viewer, served here too -------------------------------------
#
# The Linux node's page is the fleet's canonical viewer, served here as
# web/index.template.html. These are the endpoints it calls that this node did
# not have, each answered from this node's own state (mostly the measured
# pipeline above), so the page runs unchanged apart from a few macOS lines.

_SETTING_KEYS = ('AUDIO_HIGHPASS_HZ', 'AUDIO_LOWPASS_HZ', 'AUDIO_GAIN_DB',
                 'TALK_GAIN_DB', 'TALK_MUTE_SPEAKER')


def _truthy(v):
    return str(v).strip().lower() in ('1', 'on', 'true', 'yes')


def _audio_settings_body():
    return json.dumps({
        'AUDIO_HIGHPASS_HZ': str(_cfg.get('AUDIO_HIGHPASS_HZ', '') or '0'),
        'AUDIO_LOWPASS_HZ':  str(_cfg.get('AUDIO_LOWPASS_HZ', '') or '14000'),
        'AUDIO_GAIN_DB':     str(_cfg.get('AUDIO_GAIN_DB', '') or '0'),
        'TALK_GAIN_DB':      str(_cfg.get('TALK_GAIN_DB', '') or '0'),
        'TALK_MUTE_SPEAKER': _truthy(_cfg.get('TALK_MUTE_SPEAKER', '0')),
    }), 200, {'Content-Type': 'application/json'}


@app.route('/api/audio-settings', methods=['GET'])
def audio_settings_get():
    return _audio_settings_body()


@app.route('/api/audio-settings', methods=['POST'])
def audio_settings_post():
    """The Settings panel's audio values, clamped as on Tanzania. Kept in
    state/audio-settings.json over config.env (see AUDIO_SETTINGS). The
    capture is rebuilt for the room-side values; the talk values are read by
    twoway-view when the next call starts."""
    try:
        body = json.loads(request.get_data(as_text=True) or '{}')
    except Exception:
        abort(400)

    def num(v):
        try:
            return float(v)
        except (TypeError, ValueError):
            return None
    out = {}
    hp = num(body.get('AUDIO_HIGHPASS_HZ'))
    if hp is not None:
        hp = int(max(0, min(1000, hp)))
        out['AUDIO_HIGHPASS_HZ'] = str(hp) if hp else ''   # 0 = no high-pass here
    lp = num(body.get('AUDIO_LOWPASS_HZ'))
    if lp is not None:
        out['AUDIO_LOWPASS_HZ'] = str(int(max(1000, min(24000, lp))))
    g = num(body.get('AUDIO_GAIN_DB'))
    if g is not None:
        out['AUDIO_GAIN_DB'] = str(round(max(-20.0, min(30.0, g)), 1))
    tg = num(body.get('TALK_GAIN_DB'))
    if tg is not None:
        out['TALK_GAIN_DB'] = str(round(max(-20.0, min(12.0, tg)), 1))
    if 'TALK_MUTE_SPEAKER' in body:
        out['TALK_MUTE_SPEAKER'] = '1' if bool(body['TALK_MUTE_SPEAKER']) else '0'
    if not out:
        abort(400)
    saved = _load_audio_settings()
    saved.update(out)
    try:
        tmp = AUDIO_SETTINGS + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(saved, f)
        os.replace(tmp, AUDIO_SETTINGS)
    except Exception as e:
        print(f'broadcast-api: audio-settings write failed: {e}', flush=True)
        abort(500)
    room_changed = any(k.startswith('AUDIO_') and _cfg.get(k, '') != v for k, v in out.items())
    _cfg.update(out)
    if room_changed:
        _bump_mode_generation()
    return _audio_settings_body()


@app.route('/api/audio', methods=['GET'])
def audio_get():
    p = pipeline()
    live = p.get('audio_kbps') is not None and p.get('mic') == 'ok'
    return json.dumps({
        'backend': 'avfoundation',
        'channels': p.get('audio_channels'),
        'enabled': True,
        'kbps': p.get('audio_kbps'),
        'rate_hz': p.get('audio_rate_hz'),
        'state': 'ok' if live else 'off',
    }), 200, {'Content-Type': 'application/json'}


@app.route('/api/cv-state', methods=['GET'])
def cv_state_get():
    p = pipeline()
    return json.dumps({
        'mog2': bool(p.get('cv_mog2')),
        'gated': bool(p.get('cv_foveal')),
        'scene_registered': p.get('cv_scene') == 'registered',
        'scene_stale': p.get('cv_scene') == 'stale',
        'text': p.get('cv_text') or '',
        'capability_text': p.get('cv_capability_text') or '',
    }), 200, {'Content-Type': 'application/json'}


@app.route('/api/scene-status', methods=['GET'])
def scene_status_get():
    # Scene registration is Linux lightcv's; none here.
    return json.dumps({'regions': 0, 'state': 'unregistered'}), 200, {'Content-Type': 'application/json'}


@app.route('/api/cv-reset', methods=['POST'])
@app.route('/api/scene-reregister', methods=['POST'])
def cv_noop_post():
    return 'unavailable on macOS', 409


# Talk: on this node the caller's audio is played by twoway-view, which
# mediamtx starts and stops with the talkback publisher itself, so /api/talk
# only keeps the page's books (Tanzania starts its player from here).
_talk = {'on': False}


@app.route('/api/talk', methods=['GET'])
def talk_get():
    return ('true' if _talk['on'] else 'false'), 200


@app.route('/api/talk', methods=['POST'])
def talk_post():
    val = request.get_data(as_text=True).strip().lower()
    if val not in ('true', 'false', 'two-way'):
        abort(400)
    _talk['on'] = val != 'false'
    return ('true' if _talk['on'] else 'false'), 200


# WHIP/WHEP, same-origin, as Tanzania's nginx does it: /talk/ and /roomaudio/
# go to mediamtx's WebRTC port. This node's publish path is named 'talkback',
# and mediamtx's root-relative Location is rewritten to match.
import urllib.request as _urlreq
import urllib.error as _urlerr
WEBRTC_PORT = _cfg.get('WEBRTC_PORT', '8889')


def _webrtc_proxy(path):
    body = request.get_data() if request.method in ('POST', 'PATCH') else None
    req = _urlreq.Request(f'http://127.0.0.1:{WEBRTC_PORT}/{path}', data=body, method=request.method)
    for h in ('Content-Type', 'If-Match', 'Authorization'):
        if h in request.headers:
            req.add_header(h, request.headers[h])
    try:
        r = _urlreq.urlopen(req, timeout=15)
        status, data, hdrs = r.status, r.read(), r.headers
    except _urlerr.HTTPError as e:
        status, data, hdrs = e.code, e.read(), e.headers
    except Exception:
        abort(502)
    resp = Response(data, status=status)
    for h in ('Content-Type', 'Location', 'ETag', 'Link', 'Accept-Patch',
              'Access-Control-Expose-Headers'):
        v = hdrs.get(h)
        if v:
            if h == 'Location':
                v = v.replace('/talkback/', '/talk/', 1)
            resp.headers[h] = v
    return resp


@app.route('/talk/<path:rest>', methods=['GET', 'POST', 'PATCH', 'DELETE', 'OPTIONS'])
def talk_proxy(rest):
    return _webrtc_proxy('talkback/' + rest)


@app.route('/roomaudio/<path:rest>', methods=['GET', 'POST', 'PATCH', 'DELETE', 'OPTIONS'])
def roomaudio_proxy(rest):
    return _webrtc_proxy('roomaudio/' + rest)


# ── SHORT PATHS ──────────────────────────────────────────────────
# Mirrors the two names nginx publishes on the Linux nodes, so one URL
# shape works across the whole fleet:
#   /llc  -> this camera viewer
#   /elem -> ELE Messenger
# This node has no messenger, so /elem redirects into a 404. That is the
# intended answer -- the name exists everywhere, the service does not.

# ── ELE MESSENGER, LOCALLY ──────────────────────────────────────────────
# This node runs its own messenger, like every other node, and serves it on
# its own origin -- NOT proxied to a neighbour. A node that cannot say a word
# without a second node being up is not local-first, and the whole point of
# the thing is the case where the other machines are gone.
#
# The Linux nodes do this with nginx. There is no nginx here, so Flask
# carries it: the same paths, so one viewer build works on every node.
#
# KNOWN GAP: /ele-ws/ is NOT proxied. Flask's server cannot carry a
# websocket upgrade, so the full chat app loads and reads history here but
# will not receive live pushes. The viewer's Messages card is unaffected --
# it polls -- and that is the path that matters on this node. Fixing it
# properly means a real reverse proxy in front, which is a separate change.
ELE_PORT = int(_cfg.get('ELE_PORT', 8001))
ELE_DIR = os.path.join(os.path.dirname(ROOT), 'ele-messenger')


def _ele_proxy(path):
    qs = request.query_string.decode()
    url = 'http://127.0.0.1:%d/%s%s' % (ELE_PORT, path, ('?' + qs) if qs else '')
    body = request.get_data() if request.method in ('POST', 'PUT', 'PATCH') else None
    req = _urlreq.Request(url, data=body, method=request.method)
    for h in ('Content-Type', 'Authorization'):
        if h in request.headers:
            req.add_header(h, request.headers[h])
    try:
        r = _urlreq.urlopen(req, timeout=20)
        status, data, hdrs = r.status, r.read(), r.headers
    except _urlerr.HTTPError as e:
        # A 401 from the messenger is an ANSWER, not a proxy failure, and the
        # card depends on telling those apart -- it signs out on 401 and
        # keeps the session on anything else.
        status, data, hdrs = e.code, e.read(), e.headers
    except Exception:
        abort(502)
    return Response(data, status=status,
                    content_type=hdrs.get('Content-Type', 'application/json'))


@app.route('/ele-api/<path:rest>',
           methods=['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'])
def ele_api(rest):
    return _ele_proxy(rest)


@app.route('/ele-api/online')
def ele_online():
    return _ele_proxy('online')


@app.route('/ele')
@app.route('/ele/')
def serve_ele():
    return _nocache(send_from_directory(ELE_DIR, 'index.html'))


@app.route('/ele/icons/<path:fname>')
def serve_ele_icons(fname):
    return send_from_directory(os.path.join(ELE_DIR, 'icons'), fname)


@app.route('/')
def serve_home():
    # `/` is a HOME, not an app. Neither the camera nor the messenger owns
    # the index, so neither one has to be the thing you land on; each lives
    # behind its own name and the index just points at both. Mirrors the
    # nginx layout on the Linux nodes so one URL shape works fleet-wide.
    return _nocache(send_from_directory(WEB_DIR, 'home.html'))


@app.route('/llc')
def serve_index():
    return _nocache(send_from_directory(WEB_DIR, 'index.html'))


@app.route('/elem')
def serve_short_elem():
    # No messenger on this node, so this lands on a 404. That is the honest
    # answer: the name exists fleet-wide, the service does not.
    return redirect('/ele', code=302)


@app.route('/cams')
@app.route('/cams/')
def serve_cams():
    return _nocache(send_from_directory(os.path.join(WEB_DIR, 'cams'), 'cams.html'))


@app.route('/<path:path>')
def serve_static(path):
    full = os.path.join(WEB_DIR, path)
    if os.path.isfile(full):
        return _nocache(send_from_directory(WEB_DIR, path))
    abort(404)


def _shutdown(signum, frame):
    # Was dead code: defined but never registered with signal.signal(), so
    # every stop of this process -- supervisor restart, `kill`, a redeploy --
    # left its own ffmpeg children behind as real orphans, not zombies. Same
    # failure observed and fixed twice already in _writer_loop for exceptions
    # and re-entrant spawns; this is the third place a publisher restart
    # could leak, and the most direct one, since it fires on every ordinary
    # process stop rather than only on an error path. Escalates like
    # _kill_hard rather than a bare terminate(), because a capture wedged in
    # avformat_open_input ignores SIGTERM outright.
    # _mic_proc belongs here too. Without it the microphone publisher is
    # orphaned to ppid 1 on every stop, survives the restart, and keeps the
    # Icecast mount -- so the NEW publisher is refused with 403, exits, is
    # respawned, and is refused again. Heard as audio that stops, starts and
    # stops. Same leak class the video publisher had, one process later.
    for p in (_pub_proc, _cam_proc, _mic_proc):
        if p:
            _kill_hard(p)
    _stop_cv_publisher()
    sys.exit(0)


def _normalize_notify_classes():
    """Rewrite the stored class list in its expanded form, once, at startup.

    cv_notify matches these names against a track's class directly. A file
    written by an older build holds what was PICKED, so a node whose operator
    chose "All animate beings" holds the single token 'living', which matches
    nothing and alerts on nothing. Only rewrites a file that actually changes;
    a missing file stays missing, since that means "never configured" rather
    than "none".
    """
    try:
        with open(NOTIFY_CLASSES_FILE) as f:
            raw = f.read()
    except Exception:
        return
    want = ','.join(_read_notify_classes())
    picked = [c.strip().lower() for c in raw.replace('\n', ',').split(',') if c.strip()]
    if ','.join(picked) == want:
        return
    try:
        with open(NOTIFY_CLASSES_FILE, 'w') as f:
            f.write(want)
        print('broadcast-api: notify classes normalized: '
              f"{','.join(picked) or '(empty)'} -> {want or '(empty)'}", flush=True)
    except Exception as exc:
        print(f'broadcast-api: cannot normalize {NOTIFY_CLASSES_FILE}: {exc}',
              file=sys.stderr, flush=True)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT, _shutdown)
    _normalize_notify_classes()
    # Media capture/publishing runs independently of the HTTP control plane,
    # and picture and sound are now independent of EACH OTHER: one process
    # owns the camera, another owns the microphone. They share no AVFoundation
    # session, so neither can starve the other.
    threading.Thread(
        target=_writer_loop,
        daemon=True,
        name='camera-publisher',
    ).start()
    threading.Thread(
        target=_mic_publisher_loop,
        daemon=True,
        name='mic-publisher',
    ).start()

    app.run(
        host='0.0.0.0',
        port=int(_cfg.get('WEB_PORT', 8080)),
        threaded=True,
    )
