VIDEO_DEVICE=/dev/v4l/by-id/usb-DJKCVA1G4EKI5L_HP_TrueVision_HD_Camera_0001-video-index0
V4L2_INPUT_FMT=-input_format mjpeg
VIDEO_SIZE=1280x720
FRAMERATE=15
# Keyframe interval in seconds. mediamtx can only cut a segment at a
# keyframe, so this determines real segment length -- at 4 the configured
# 1s hlsSegmentDuration is silently ignored and viewers get ~12s of
# live-edge lag. Raise it only if the encoder cannot keep up.
GOP_SECONDS=1
# Stopgap: yolov8n is the only model light enough for tina, so every
# node points at the same tiny model for now. See models/candidates/
# comment above.
CV_DETECT_MODEL=/usr/share/hls-livecam-server/models/candidates/yolov8n.onnx

# --- preserved from a previous config; not managed by setup ---
# Keyframe interval in seconds. mediamtx can only cut a segment at a
# keyframe, so this determines real segment length -- at 4 the configured
# 1s hlsSegmentDuration is silently ignored and viewers get ~12s of
# live-edge lag. Raise it only if the encoder cannot keep up.
# Stopgap: yolov8n is the only model light enough for tina, so every
# node points at the same tiny model for now. See models/candidates/
# comment above.
# --- preserved from a previous config; not managed by setup ---
# Keyframe interval in seconds. mediamtx can only cut a segment at a
# keyframe, so this determines real segment length -- at 4 the configured
# 1s hlsSegmentDuration is silently ignored and viewers get ~12s of
# live-edge lag. Raise it only if the encoder cannot keep up.
# Stopgap: yolov8n is the only model light enough for tina, so every
# node points at the same tiny model for now. See models/candidates/
# comment above.
# ── CV Mode tuning ────────────────────────────────────────────────────
# Every key below is optional. Omit one and the built-in default applies;
# defaults live in /usr/share/hls-livecam-server/cv_processor.py (_DEFAULTS),
# which is the source of truth if this legend ever drifts from it.
#
# Cameras on this fleet differ enormously -- a healthy 1280x720 sensor and
# one with peeled sensor film and dirt inside the lens do not share good
# values. Tune per node; do not copy a whole block between machines.
#
# RENDER
#   CV_EDGE_STYLE       overlay | sharpie | xdog
#                       overlay: difference-of-Gaussians inked over the photo.
#                         The restrained default and the best measured result
#                         on a degraded sensor.
#                       sharpie: discards the photo for a line drawing. Cheap,
#                         but throws away photographic signal.
#                       xdog:   tone-preserving extended DoG. Comparable to
#                         overlay, not better -- keep CV_XDOG_SIGMA >= 3 or it
#                         inks the JPEG block grid instead of the room.
#                       An unrecognised value silently renders as overlay.
#   CV_EDGE_STRENGTH    opacity of the darkest strokes (overlay). 0.25 is
#                       restrained; 1.3 manufactures halos on a soft lens.
#   CV_EDGE_SIGMA       stroke width. CV_EDGE_PERCENTILE normalises the DoG
#                       against a high percentile rather than the max, so one
#                       hot pixel cannot scale every real stroke to nothing.
#   CV_EDGE_SHARPNESS_MIN / _OFF
#                       Edges engage below _MIN and are absent at/above _OFF,
#                       measured as variance-of-Laplacian. Setting _OFF far
#                       above a node's actual sharpness pins the stage fully
#                       on at all times.
#   CV_UNSHARP_AMOUNT   Removing sharpening entirely reads as too soft;
#                       heavy sharpening amplifies sensor noise. There is an
#                       optimum in between.
#
# DETECTION
#   CV_DETECT_CONF      Confidence floor. BELOW roughly 0.1 on a degraded
#                       sensor the class head is noise with labels attached --
#                       weak scores establish that something is THERE, never
#                       what it is.
#   CV_DETECT_CLASSES   Narrow what this node looks for: "cat", or "15,0".
#                       Empty = every class in COCO_LABELS. Use this instead
#                       of editing cv_detect.py -- a source edit is reverted
#                       by every package upgrade.
#   CV_DETECT_ACUITY_ADAPT
#                       Scales the detector's input to the frame's measured
#                       acuity, because feeding a detector more pixels than
#                       the optics resolve costs accuracy. A healthy lens
#                       clamps to 1.0 and is untouched. Do not lower
#                       CV_DETECT_SCALE_MIN below 0.30: at 0.12 the detector
#                       returned nothing at all on 20% of frames.
#
# SCENE / PERSISTENCE  (both off by default)
#   CV_SCENE_ENABLED    Reference-image scene model. Needs a registration
#                       artifact; cross-device registration does not work on
#                       a badly degraded lens.
#   CV_PERSIST_ENABLED  Long-lived scene entities that survive restarts.
#                       Identity is an entity, not a bounding box.
# ──────────────────────────────────────────────────────────────────────
# --- preserved from a previous config; not managed by setup ---
# Keyframe interval in seconds. mediamtx can only cut a segment at a
# keyframe, so this determines real segment length -- at 4 the configured
# 1s hlsSegmentDuration is silently ignored and viewers get ~12s of
# live-edge lag. Raise it only if the encoder cannot keep up.
# Stopgap: yolov8n is the only model light enough for tina, so every
# node points at the same tiny model for now. See models/candidates/
# comment above.
CV_DETECT_CLASSES=human,cat
CV_DETECT_CONF=0.35
CV_SCENE_ENABLED=1
CV_SCENE_SOURCE=own-camera
CV_SCENE_REFERENCE=/var/lib/hls-livecam/scene_model.json
lili
# Room audio (run-21). Off means the publisher is byte-identical to before.
# Levels were the whole problem on this node: Capture sat at 63/100% (+30dB)
# with Internal Mic Boost also at +30dB, so the input railed -- mean -2.4dB,
# DC offset 0.34, flat factor 88. Set to Capture=26, Boost=0 and persisted
# with alsactl store; a quiet room now reads mean -58dB / peak -38dB.
AUDIO_ENABLED=1
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
lili
# Capture staging, forced at every publisher start. PulseAudio reapplies its
# own levels behind us and alsactl store does not hold; this node was found
# railing at +30dB Capture with +30dB Mic Boost.
AUDIO_MIXER_CARD=PCH
AUDIO_MIXER_LEVELS=Capture=50,Internal Mic Boost=0
lili
# One capture session for A and V, the way macOS gets it from avfoundation.
# Needs snd-aloop (loaded via /etc/modules-load.d/hls-livecam-aloop.conf).
AUDIO_SINGLE_SESSION=0
AUDIO_LOOPBACK_SINK=hw:Loopback,0,0
AUDIO_LOOPBACK_SRC=hw:Loopback,1,0
CV_FOVEAL_ENABLED=1
TALK_GAIN_DB=0
ECHO_DUCK=0
AUDIO_DEVICE=hw:CARD=PCH,DEV=0
TALK_OUTPUT=hw:CARD=PCH,DEV=0
AUDIO_LOUDNORM=off

# Cat sightings to Telegram: a snapshot when CV confirms a cat (CV mode only).
NOTIFY_ENABLED=1
NOTIFY_CLASSES=cat
NOTIFY_APPRISE_URLS_FILE=/etc/hls-livecam/notify.urls
