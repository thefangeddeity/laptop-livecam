# hls-livecam-server (macOS port) — configuration
# Written by livecam-setup. Consumed by every component.
AVF_VIDEO_INDEX=0
AVF_DEVICE_NAME=FaceTime HD Camera (Built-in)
VIDEO_SIZE=1280x720
FRAMERATE=15

WEB_PORT=8080
RTSP_PORT=8554
HLS_PORT=8888

# Room mic is quiet at source (~-39 dB mean). Gain is applied at capture
# through a limiter; a browser cannot amplify beyond the source level.
AUDIO_GAIN_DB=

# Product identity. The fleet runs two: HLS Livecam (HLSLS) and HLS LightCV
# (HLSLCVS). Which one a node runs is a property of the node, not the
# platform -- amira is a Mac running LightCV.
PRODUCT_NAME=HLS Livecam
PRODUCT_SHORT=HLSLS

# CV mode. Benchmarked at 43.3ms/frame on ariana (i5-6287U, 2 cores) --
# 65% of the 15fps budget, comfortably inside it. The Linux phases ruled out
# automatic floor inference and scene registration on their hardware; that
# does not bear on whether a detector runs here at all, and it does here.
#
# yolov8n.onnx is not shipped -- Ultralytics' weight licensing is unresolved
# and this repo is public. It is a device-local file, same as vendor/mediamtx:
# bring your own to CV_DETECT_MODEL's path (default: Application Support,
# below), gitignored, never committed. Detection degrades to a logged no-op
# if it isn't there, so this default being on costs nothing on a node without
# the file.
CV_DETECT_ENABLED=1
CV_HUD_ENABLED=1
AUDIO_HIGHPASS_HZ=60
AUDIO_DENOISE=
AUDIO_NR_DB=
AUDIO_NOTCH_HZ=3050-3100
CV_FIRST_FRAME_TIMEOUT_S=20

# --- Cat alerts (ported from tanzania) -------------------------------------
# Telegram goes out through cv_notify's own urllib path, so apprise is not
# required here; the URL file carries the bot token and is 0600.
NOTIFY_ENABLED=1
NOTIFY_CLASSES=human,cat,dog
NOTIFY_NAME=Ariana
NOTIFY_APPRISE_URLS_FILE=$HOME/Library/Application Support/HLS Livecam/state/notify.urls
# Motion gate: furniture never moves and sits at fg=0.00, a real arrival does
# not. This is what stopped tanzania reporting a crumpled bag every 5 minutes.
NOTIFY_MIN_FG=0.25
CV_DETECT_CONF=0.50
# Checkbox-driven; the detector names human/cat/dog/bird and this gates which
# of them actually raise an alert, re-read per event so there is no restart.
NOTIFY_CLASSES_FILE=$REPO/state/notify_classes
# Best 1 of the ~6 candidates in the window. At one shot the arrival-frame
# reservation is dropped on purpose: the arrival frame is reliably the
# blurriest (the subject is moving), so reserving it would send the worst
# picture available and call it the best.
NOTIFY_SHOTS=1
NOTIFY_VIDEO_FILE=$REPO/state/notify_video

# -- The gallery ------------------------------------------------------------
# One crop kept per visit so an individual can be named later. Left unset it
# is derived from DETECT_ROI_FILE's directory; if that cannot be derived the
# gallery is OFF, because inventing somewhere to write pictures of people is
# a worse failure than not keeping them.
#GALLERY_DIR=$REPO/state/gallery
# How many UNNAMED crops to keep. Named ones are never pruned -- those are
# something you chose to keep.
#GALLERY_KEEP=400
# Context around the detection box, as a fraction of it. Cut exactly to the
# box, a cat loses the ear tips and tail that tell it from the other one.
#GALLERY_PAD=0.15

# -- BUZZ, out loud ---------------------------------------------------------
# BUZZ has two halves: one shakes every viewer's screen, the other plays a
# tone on THIS machine's speakers, for reaching somebody in the room with the
# camera. Through the sound card, not the PC speaker.
#
# The tone alternates 1400 Hz and 2100 Hz, ~2.3s. Measured, not guessed: a
# swept sine recorded through a laptop's own mic showed peaks near 950/1400/
# 2600 Hz and everything above ~3200 Hz more than 20 dB down, so a square
# wave wastes its harmonics and a single tone can sit in a room null. See the
# header of bin/buzz_tone.py for the numbers.
#BUZZ_TONE=true
# Raise the output volume for the duration and put it back. Worth 25-30 dB --
# more than every tone choice combined. Set false to play at whatever the
# volume already is.
#BUZZ_TONE_MAX_VOLUME=true
# Leave unset to use the system default output.
#BUZZ_TONE_DEVICE=
